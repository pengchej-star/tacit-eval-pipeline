{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '540,710p' current_code.py\"","aggregated_output":"def get_raw_eeg_1d_transforms(**transform_parameters):\n\n    \"\"\"\n    Get raw EEG 1D transforms for dataset\n\n    Parameters\n    ----------\n    transform_parameters: dict\n        Dictionary of transform parameters\n\n    Returns\n    -------\n    eeg_transforms: dict\n        Transforms for training and inference\n    \"\"\"\n\n    training_transforms = A.Compose([\n        ChannelDifference(ekg=True, always_apply=True),\n        A.VerticalFlip(p=transform_parameters['vertical_flip_probability']),\n        A.HorizontalFlip(p=transform_parameters['horizontal_flip_probability']),\n        CenterTemporalDropout1D(\n            n_time_steps=transform_parameters['center_temporal_dropout_time_steps'],\n            drop_value=0,\n            p=transform_parameters['center_temporal_dropout_probability']\n        ),\n        NonCenterTemporalDropout1D(\n            n_time_steps=transform_parameters['non_center_temporal_dropout_time_steps'],\n            drop_value=0,\n            p=transform_parameters['non_center_temporal_dropout_probability']\n        ),\n        InstanceNormalization1D(per_channel=True, always_apply=True),\n        ToTensor1D(always_apply=True)\n    ])\n\n    inference_transforms = A.Compose([\n        ChannelDifference(ekg=True, always_apply=True),\n        InstanceNormalization1D(per_channel=True, always_apply=True),\n        ToTensor1D(always_apply=True)\n    ])\n\n    eeg_transforms = {'training': training_transforms, 'inference': inference_transforms}\n    return eeg_transforms\n\n\n# %% [markdown]\n# ## Inference\n\n# %%\ndevice = torch.device('cuda')\namp = True\n\nraw_eeg_1d_transforms = get_raw_eeg_1d_transforms(**raw_eeg_1d_eegnet_models_config['transforms'])['inference']\nraw_eeg_1d_tta = True\nraw_eeg_1d_task_type = 'binary'\n\n# %%\ntest_raw_eeg_1d_predictions = []\n\nfor idx, row in df.iterrows():\n    \n    eeg_path = eeg_directory / f'{int(row[\"eeg_id\"])}.parquet'\n    eeg = pd.read_parquet(eeg_path)\n    eeg = eeg.interpolate(method='linear', limit_area='inside')\n    eeg = eeg.fillna(0).values\n        \n    raw_eeg_1d_inputs = raw_eeg_1d_transforms(image=eeg)['image'].float()\n    raw_eeg_1d_inputs = raw_eeg_1d_inputs.to(device)\n    \n    raw_eeg_1d_predictions = torch.zeros(1, 6)\n\n    if raw_eeg_1d_tta:\n        raw_eeg_1d_inputs = torch.stack((\n            raw_eeg_1d_inputs,\n            torch.flip(raw_eeg_1d_inputs, dims=(0,)),\n            torch.flip(raw_eeg_1d_inputs, dims=(1,)),\n            torch.flip(raw_eeg_1d_inputs, dims=(0, 1))\n        ), dim=0)\n    else:\n        raw_eeg_1d_inputs = torch.unsqueeze(raw_eeg_1d_inputs, dim=0)\n\n    for model_idx, models in enumerate([raw_eeg_1d_eegnet_models]):\n        for model in models.values():\n            with torch.no_grad():\n                if amp:\n                    with torch.autocast(device_type='cuda', dtype=torch.float16):\n                        raw_eeg_1d_outputs = model(raw_eeg_1d_inputs)\n                else:\n                    raw_eeg_1d_outputs = model(raw_eeg_1d_inputs)\n\n            raw_eeg_1d_outputs = raw_eeg_1d_outputs.cpu()\n            if raw_eeg_1d_tta:\n                raw_eeg_1d_outputs = torch.mean(raw_eeg_1d_outputs, dim=0)\n            else:\n                raw_eeg_1d_outputs = torch.squeeze(raw_eeg_1d_outputs, dim=0)\n            \n            raw_eeg_1d_predictions += raw_eeg_1d_outputs / len(models)\n    \n    if raw_eeg_1d_task_type == 'binary':\n        raw_eeg_1d_predictions = torch.sigmoid(raw_eeg_1d_predictions).numpy()\n        raw_eeg_1d_predictions = raw_eeg_1d_predictions / raw_eeg_1d_predictions.sum(axis=1).reshape(-1, 1)\n    elif raw_eeg_1d_task_type == 'multiclass':\n        raw_eeg_1d_predictions = torch.softmax(raw_eeg_1d_predictions, dim=-1).numpy()\n\n    test_raw_eeg_1d_predictions.append(raw_eeg_1d_predictions)\n\ntest_raw_eeg_1d_predictions = np.concatenate(test_raw_eeg_1d_predictions)\ntest_raw_eeg_1d_predictions\n\n# %% [markdown]\n# ## Post-processing\n\n# %%\ndef normalize_probabilities(df, columns):\n\n    \"\"\"\n    Normalize probabilities to 1 within given columns\n\n    Parameters\n    ----------\n    df: pandas.DataFrame\n        Dataframe with given columns\n\n    columns: list\n        List of column names that have probabilities\n\n    Returns\n    -------\n    df: pandas.DataFrame\n        Dataframe with given columns' sum adjusted to 1\n    \"\"\"\n\n    df_sums = df[columns].sum(axis=1)\n    for column in columns:\n        df[column] /= df_sums\n\n    return df\n\n\n# %%\ntarget_columns = ['seizure_vote', 'lpd_vote', 'gpd_vote', 'lrda_vote', 'grda_vote', 'other_vote']\nraw_eeg_1d_prediction_columns = [f'{column}_raw_eeg_1d_prediction' for column in target_columns]\n\ndf[raw_eeg_1d_prediction_columns] = test_raw_eeg_1d_predictions\n\n#df['seizure_vote_spectrogram_prediction'] *= 1.\n#df['lpd_vote_spectrogram_prediction'] *= 1.5\n#df['gpd_vote_spectrogram_prediction'] *= 1.5\n#df['lrda_vote_spectrogram_prediction'] *= 1.75\n#df['grda_vote_spectrogram_prediction'] *= 1.5\n#df['other_vote_spectrogram_prediction'] *= 1.\n\ndf = normalize_probabilities(df=df, columns=raw_eeg_1d_prediction_columns)\ndf\n\n# %% [markdown]\n# ## Submission\n\n# %%\ndf_submission = df.loc[:, ['eeg_id']]\ndf_submission[target_columns] = df[raw_eeg_1d_prediction_columns]\ndf_submission\n\n# %%\ndf_submission.to_csv('submission.csv', index=False)\n\n# %%\n\n\n# %%\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"mkdir -p output\npython - <<'PY'\nfrom pathlib import Path\nimport json\nsource = Path('current_code.py').read_text()\nstart = source.index('# %%\\\\ntest_raw_eeg_1d_predictions = []')\nend = source.index('# %% [markdown]\\\\n# ## Post-processing', start)\nreplacement = '''# %%\ndef logits_to_probabilities(logits, task_type):\n    \\\"\\\"\\\"Convert each individual view to a categorical distribution in float32.\\\"\\\"\\\"\n    logits = logits.float()\n    if task_type == 'binary':\n        # softmax(log(sigmoid(logits))) is normalized sigmoid, evaluated\n        # stably even when all six logits are very negative.\n        return torch.softmax(F.logsigmoid(logits), dim=-1)\n    if task_type == 'multiclass':\n        return torch.softmax(logits, dim=-1)\n    raise ValueError(f'Unsupported task type: {task_type}')\n\n\n# %%\ntest_raw_eeg_1d_predictions = []\nassert len(raw_eeg_1d_eegnet_models) > 0, 'No EEG checkpoints loaded'\n\nfor idx, row in df.iterrows():\n\n    eeg_path = eeg_directory / f'{int(row[\\\"eeg_id\\\"])}.parquet'\n    eeg = pd.read_parquet(eeg_path)\n    eeg = eeg.interpolate(method='linear', limit_area='inside')\n    eeg = eeg.fillna(0).values\n\n    raw_eeg_1d_inputs = raw_eeg_1d_transforms(image=eeg)['image'].float()\n    raw_eeg_1d_inputs = raw_eeg_1d_inputs.to(device)\n\n    if raw_eeg_1d_tta:\n        raw_eeg_1d_inputs = torch.stack((\n            raw_eeg_1d_inputs,\n            torch.flip(raw_eeg_1d_inputs, dims=(0,)),\n            torch.flip(raw_eeg_1d_inputs, dims=(1,)),\n            torch.flip(raw_eeg_1d_inputs, dims=(0, 1))\n        ), dim=0)\n    else:\n        raw_eeg_1d_inputs = torch.unsqueeze(raw_eeg_1d_inputs, dim=0)\n\n    raw_eeg_1d_predictions = torch.zeros(1, 6, device=device, dtype=torch.float32)\n    with torch.inference_mode():\n        for model in raw_eeg_1d_eegnet_models.values():\n            if amp:\n                with torch.autocast(device_type='cuda', dtype=torch.float16):\n                    raw_eeg_1d_outputs = model(raw_eeg_1d_inputs)\n            else:\n                raw_eeg_1d_outputs = model(raw_eeg_1d_inputs)\n\n            # Mix distributions, not logits: one overconfident fold/view\n            # should not veto probability mass supported by the others.\n            # Normalize before BOTH the view mean and the fold mean.\n            view_probabilities = logits_to_probabilities(\n                raw_eeg_1d_outputs, raw_eeg_1d_task_type\n            )\n            raw_eeg_1d_predictions += (\n                view_probabilities.mean(dim=0, keepdim=True)\n                / len(raw_eeg_1d_eegnet_models)\n            )\n\n    # Only a numerical floor; do not apply sigmoid again to the mixture.\n    raw_eeg_1d_predictions = raw_eeg_1d_predictions.clamp_min(1e-7)\n    raw_eeg_1d_predictions /= raw_eeg_1d_predictions.sum(dim=-1, keepdim=True)\n    test_raw_eeg_1d_predictions.append(raw_eeg_1d_predictions.cpu().numpy())\n\ntest_raw_eeg_1d_predictions = np.concatenate(test_raw_eeg_1d_predictions)\nassert test_raw_eeg_1d_predictions.shape == (len(df), 6)\nassert np.isfinite(test_raw_eeg_1d_predictions).all(), 'Non-finite EEG probabilities'\nassert np.allclose(test_raw_eeg_1d_predictions.sum(axis=1), 1.0, atol=1e-6)\ntest_raw_eeg_1d_predictions\n\n'''\nrevised = source[:start] + replacement + source[end:]\nrevised = revised.replace(\\\"df_submission = df.loc[:, ['eeg_id']]\\\", \\\"df_submission = df.loc[:, ['eeg_id']].copy()\\\")\nPath('output/revised_code.py').write_text(revised)\nobservations = [\n    ('Does the competition minimize KL divergence?', 'yes', 'task.md, Evaluation and metric direction: predictions are scored by KL divergence, lower is better.'),\n    ('Must each submission row sum to one?', 'yes', 'task.md, Submission File: six vote probabilities per eeg_id must sum to one; the required filename is submission.csv.'),\n    ('Is v54 the best scored version in the supplied history?', 'no', 'history.md: v54 scores 0.41624; v50 scores 0.41016.'),\n    ('Have recent checkpoint swaps consistently improved the leaderboard score?', 'no', 'history.md: v50 0.41016, v51 0.41096, v52 0.42095, v53 0.42162, v54 0.41624.'),\n    ('Does the supplied history document a trial of probability-space ensemble averaging?', 'no', 'history.md describes checkpoint, architecture, preprocessing, TTA and naming changes, but no explicit conversion of every fold/view to a probability distribution before averaging. Older versions are omitted.'),\n    ('Does the active pipeline use a five-fold EEGNet ensemble?', 'yes', 'current_code.py: load_eegnet_model loads five listed checkpoints from raw_eeg_1d_eegnet_19x10000_quality_2.'),\n    ('Is the spectrogram ensemble active?', 'no', 'current_code.py: the spectrogram load_timm_model call is enclosed in a triple-quoted string; inference uses raw_eeg_1d_eegnet_models only.'),\n    ('Does ClassificationHead return unactivated logits?', 'yes', 'current_code.py: ClassificationHead.forward returns self.classifier(x), an nn.Linear output.'),\n    ('Does inference retain the four flip combinations?', 'yes', 'current_code.py, Inference: raw_eeg_1d_tta=True stacks the original, channel flip, time flip and combined flip.'),\n    ('Are flip augmentations represented in the training transform definition?', 'yes', 'current_code.py, get_raw_eeg_1d_transforms: A.VerticalFlip and A.HorizontalFlip use configured probabilities; the actual external configuration is unavailable.'),\n    ('Does the current pipeline average TTA logits before activation?', 'yes', 'current_code.py, Inference: torch.mean(raw_eeg_1d_outputs, dim=0) precedes the sigmoid/softmax branch.'),\n    ('Does the current pipeline average fold logits before activation?', 'yes', 'current_code.py, Inference: raw_eeg_1d_predictions accumulates raw_eeg_1d_outputs / len(models); sigmoid is applied after the model loop.'),\n    ('Is binary output normalization the selected