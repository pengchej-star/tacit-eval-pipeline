l, dataloader)\n    predictions.append(prediction)\n\npreds = np.mean(predictions, axis=0).reshape(-1, )\noptimized_rounder = OptimizedRounder()\nif DEBUG:\n    sub = df[[\"essay_id\"]]\nelse:\n    sub = pd.read_csv(\"/kaggle/input/learning-agency-lab-automated-essay-scoring-2/sample_submission.csv\")\n\nsub.loc[:, \"score\"] = optimized_rounder.predict(preds, np.array(json.loads(args.weights)))\n# sub.loc[:, \"score\"] = preds.round(0).astype(int)\nsub.to_csv(args.save_name, index=False)\n\n# %%\n# %%\n%%writefile predict_separated.py\nimport math\nimport json\nimport sys\nsys.path.append(\"/kaggle/input/omegaconf\")\nsys.path.append(\"/kaggle/input/aes2-code/kaggle-aes2-v2/kaggle-aes2-v2\")\nfrom argparse import ArgumentParser\n\nimport datasets\nimport torch\nimport torch.utils.data\nimport numpy as np\nimport pandas as pd\nfrom datasets import Dataset\nfrom omegaconf import OmegaConf\nfrom tqdm.auto import tqdm\nfrom transformers import AutoTokenizer, AddedToken\n\nfrom aes2.utils.collators.sequence_bucket import SequenceBucketPadCollator\nfrom aes2.utils.dataset.simple import CompetitionDataset\nfrom aes2.utils.metrics import OptimizedRounder\n\nparser = ArgumentParser()\nparser.add_argument(\"--config\", default=None, required=False)\nparser.add_argument(\"--checkpoints\", type=str)\nparser.add_argument(\"--save-name\", type=str)\nparser.add_argument(\"--weights\", type=str)\nparser.add_argument(\"--only-round\", default=False, action=\"store_true\")\n\nargs, unknown_args = parser.parse_known_args()\n\n\ndef tokenize(example, tokenizer, max_length=1024):\n    full_text = example[\"full_text\"]\n    truncation = True\n    encoding = tokenizer(full_text, return_token_type_ids=False, truncation=truncation, max_length=max_length)\n\n    return {\n        \"input_ids\": encoding[\"input_ids\"],\n        \"attention_mask\": encoding[\"attention_mask\"],\n        \"length\": len(encoding[\"input_ids\"]),\n        \"is_pc2\": 0\n    }\n\n\ndef loc_datasets(ds, keep_columns):\n    return Dataset.from_dict({col: ds[col] for col in keep_columns})\n\n\n\n@torch.no_grad()\ndef inference(model, dataloader):\n    predictions = []\n    model.eval()\n    for x in tqdm(dataloader, total=len(dataloader)):\n        predictions.append(model({key: x[key].to(\"cuda\") for key in x}).cpu().numpy())\n    return np.concatenate(predictions, axis=0)\n\n\nDEBUG = False\nconfig = OmegaConf.load(args.config)\nconfig.merge_with_dotlist(unknown_args)\ndf = pd.read_csv(\"/kaggle/input/learning-agency-lab-automated-essay-scoring-2/test.csv\")\ntokenizer = AutoTokenizer.from_pretrained(config.model.path)\ntokenizer.add_tokens([AddedToken(\"\\n\\n\", normalized=False)])\ntokenizer.add_tokens([AddedToken(\"\\n\", normalized=False)])\n\nif DEBUG:\n    df[\"full_text\"] = df[\"full_text\"].apply(lambda x: x + \"\\n\" + x + \"\\n\" + x)\n    df = pd.concat([df] * 2000, axis=0).reset_index(drop=True)\nds = datasets.Dataset.from_pandas(df)\nds = ds.map(lambda x: tokenize(x, tokenizer, max_length=config.train.validate_max_length), num_proc=2)\ndf[\"length\"] = ds[\"length\"]\nds = ds.sort(\"length\")\nsorted_ids = ds[\"essay_id\"]\nds = loc_datasets(ds, [\"input_ids\", \"attention_mask\", \"is_pc2\"])\n\ncollate_fn = SequenceBucketPadCollator(max_length=config.train.validate_max_length, tokenizer=tokenizer)\ndataloader = torch.utils.data.DataLoader(\n    CompetitionDataset(x=ds), batch_size=config.train.batch_size,\n    shuffle=False, num_workers=2,\n    collate_fn=collate_fn\n)\ncheckpoints = json.loads(args.checkpoints)\n# if config.train.exp_name in [\"exp302\", \"exp301\"]:\nfrom training.separated.models import AESRegressionModel as ModelClass\n\nmodel = ModelClass(config).to(\"cuda\")\nmodel.backbone.resize_token_embeddings(len(tokenizer))\n\npredictions = []\nfor checkpoint in checkpoints:\n    print(f\"<<< process: {checkpoint}\")\n    model.load_state_dict(torch.load(checkpoint))\n    prediction = inference(model, dataloader)\n    predictions.append(prediction)\n\npreds = np.mean(predictions, axis=0).reshape(-1, )\nif DEBUG:\n    sub = df[[\"essay_id\"]]\nelse:\n    sub = pd.read_csv(\"/kaggle/input/learning-agency-lab-automated-essay-scoring-2/sample_submission.csv\")\n\noptimized_rounder = OptimizedRounder()\nsub = pd.DataFrame({\"essay_id\": sorted_ids}).merge(sub, on=\"essay_id\", how=\"left\")\nsub.loc[:, \"score\"] = optimized_rounder.predict(preds, np.array(json.loads(args.weights)))\n# sub.loc[:, \"score\"] = preds.round(0).astype(int)\nsub[[\"essay_id\", \"score\"]].to_csv(args.save_name, index=False)\n\n# %% [markdown]\n      - desiderata · what fits this case?: Training is unstable or converges poorly at the current learning rate. · The training loss stalls at a schedule transition or under the current optimizer. · Training ends while validation improves or continues well beyond its best epoch. · The training loss poorly represents the ranking, distribution, or ordinal evaluation objective. · A component lacks consistent fold training or reproducible held-out predictions.\n      - desiderata · added from expert visits: Changing the loss function alters effective gradient magnitudes, requiring a compensating learning rate adjustment. · The response surface around the current best hyperparameter value has been partially mapped, and small perturbations near it are the natural next step. · A previously tested hyperparameter value produced the best known score and should be reverted to as a baseline before making other changes. · The previous edit changed multiple hyperparameters simultaneously, so individual effects are confounded. · A regularization hyperparameter (e.g., dropout) was changed alongside another modification and may now be mis-calibrated for the current configuration. · The neural network's key hyperparameters (architecture size, learning rate, etc.) have not been tuned from their defaults.\n      - **Tune learning rate** `T.5.4.1`\n      - **Change optimizer or learning-rate schedule** `T.5.4.2`\n      - **Change training duration or stages** `T.5.4.3`\n      - **Change the training objective** `T.5.4.4`\n      - **Make component training cross-validated** `T.5.4.5`\n  - **Change the prediction pool** `T.6`\n    - decide: How should I change which trained predictors contribute? → Choose the source of ensemble diversity | Choose ensemble membership | Select a trained artifact\n    - desiderata · what fits this case?: Existing members mostly share the same architecture, features, targets, or training randomness. · There are untested, weak, or recently changed members in the current pool. · Several compatible saved runs or training-stage artifacts are available.\n    - desiderata · added from expert visits: The fold count has not been varied alongside member selection to understand its interaction with pool composition. · Empirical evidence shows that adding more members to the pool improved the score. · A known preprocessing or architecture variant that already improved the ensemble suggests a further related variant could add diversity. · Validation loss in checkpoint filenames does not reliably predict leaderboard performance, complicating member selection. · A smaller model variant outperformed a larger variant on the leaderboard, suggesting model size is not a reliable proxy for pool contribution. · A candidate subset ensemble has not been submitted, so there is no evidence it outperforms the current full ensemble.\n    - **Choose the source of ensemble diversity** `T.6.1`\n      - decide: What kind of additional predictor should I test? → Add a different model family | Add an alternative input representation | Add an alternative supervision recipe | Average more fold or snapshot predictions | Average independently seeded models | Average checkpoint weights\n      - desiderata · what fits this case?: Current members share a family and their held-out errors are highly correlated. · A relevant modality, feature set, or preprocessing view is not represented. · Alternative valid target transforms or training recipes yield different held-out errors. · Compatible unused fold or snapshot predictions are already available. · Training seeds produce materially different held-out predictions. · Compatible checkpoints from one weight-space trajectory are saved.\n      - **Add a different model family** `T.6.1.1`\n      - **Add an alternative input representation** `T.6.1.2`\n      - **Add an alternative supervision recipe** `T.6.1.3`\n      - **Average more fold or snapshot predictions** `T.6.1.4`\n      - **Average independently seeded models** `T.6.1.5`\n      - **Average checkpoint weights** `T.6.1.6`\n    - **Choose ensemble membership** `T.6.2`\n      - decide: Which membership experiment should I run next? → Measure a candidate in isolation | Test one additional member | Remove a harmful or redundant member | Replace one fixed ensemble slot | Restore complementary members | Retest membership after upstream changes\n      - desiderata · what fits this case?: The candidate has not yet produced verified standalone predictions. · A functioning candidate has plausible complementary errors but no marginal-blend result. · A member is weak, redundant, or associated with a regression. · A new compatible checkpoint can replace a specific weaker slot. · Removing formerly useful members caused a reproducible regression. · Other model components or aggregation rules changed since the last membership test.\n      - **Measure a candidate in isolation** `T.6.2.1`\n      - **Test one additional member** `T.6.2.2`\n      - **Remove a harmful or redundant member** `T.6.2.3`\n      - **Replace one fixed ensemble slot** `T.6.2.4`\n      - **Restore complementary members** `T.6.2.5`\n      - **Retest membership after upstream changes** `T.6.2.6`\n    - **Select a trained artifact** `T.6.3`\n      - decide: Which checkpoint comparison should I perform? → Compare trained runs or folds | Compare training stages or stopping rules | Compare full-data and fold-trained weights\n      - desiderata · what fits this case?: Several runs or fold checkpoints have matching architecture and preprocessing. · Artifacts differ mainly by training stage or stopping criterion. · Both full-data-trained and fold-trained artifacts are available.\n      - **Compare trained runs or folds** `T.6.3.1`\n      - **Compare training stages or stopping rules** `T.6.3.2`\n      - **Compare full-data and fold-trained weights** `T.6.3.3`\n  - **Change prediction combination or output mapping** `T.7`\n    - decide: Which operation on valid predictions should I change? → Choose a combination rule | Choose how to weight predictors | Choose meta-model inputs | Map continuous scores to discrete labels | Correct output semantics or bias | Choose inference-time averaging\n    - desiderata · what fits this case?: Prediction scales or the aggregation domain differ across members. · The same valid prediction pool has only an arbitrary weight allocation. · A downstream learner uses base predictions or embeddings as input features. · The task requires discrete ordered outputs or labels occupy a few repeated levels. · Prediction units, probability calibration, or subgroup residual bias need correction. · The input has valid alternate views that the current inference uses only once.\n    - desiderata · added from expert visits: A code bug or misconfiguration (wrong mode, missing argument, wrong column reference, syntax error, or broken file path) prevents one or more ensemble members from producing correct predictions. · The blending code or saved artifacts are stale or mismatched with the current set of ensemble members. · A previously disabled or excluded model checkpoint is available and was part of a better-scoring configuration. · The pipeline mishandles multi-fold or multi-dimensional prediction arrays, causing shape or aggregation errors. · Non-deterministic execution (e.g., stochastic preprocessing, worker ordering, unseeded randomness) causes prediction outputs to vary across identical runs.\n    - **Choose a combination rule** `T.7.1`\n      - decide: Which rule should I compare against the current aggregation? → Compare rank and raw-score averaging | Compare probability and logit aggregation | Group before averaging | Fit a regularized prediction stacker | Change the meta-learner | Try a nonlinear probability blend\n      - desiderata · what fits this case?: The metric rewards ordering and members have different score scales. · Members expose logits and probabilities for a distribution-based metric. · Model families contribute unequal numbers of fold or seed predictions. · Aligned leakage-free out-of-fold predictions exist for a simple learned blender. · An established stacker has plateaued and its model class or penalty is untested. · Probability saturation may make arithmetic averaging overly dominated by confident members. · Only tiny or noisy calibration data are available relative to meta-model flexibility.\n      - **Compare rank and raw-score averaging** `T.7.1.1`\n      - **Compare probability and logit aggregation** `T.7.1.2`\n      - **Group before averaging** `T.7.1.3`\n      - **Fit a regularized prediction stacker** `T.7.1.4`\n      - **Change the meta-learner** `T.7.1.5`\n      - **Try a nonlinear probability blend** `T.7.1.6`\n    - **Choose how to weight predictors** `T.7.2`\n      - decide: Which weighting strategy should I use as the next comparison? → Tune nonuniform blend weights | Use a uniform-weight baseline | Allow signed blend coefficients | Compare conditional and global weights | Retune after component changes | Normalize component scales\n      - desiderata · what fits this case?: Members differ reliably in quality or complementary error structure. · Equal weighting matches tuned weights within measured score noise. · Prior unconstrained or signed fits suggest a component can cancel correlated error. · Component strengths differ consistently by an observable class or subgroup. · Member quality, count, augmentation, or scaling changed after weights were selected. · Component prediction scales differ substantially or contain heavy outliers.\n      - **Tune nonuniform blend weights** `T.7.2.1`\n      - **Use a uniform-weight baseline** `T.7.2.2`\n      - **Allow signed blend coefficients** `T.7.2.3`\n      - **Compare conditional and global weights** `T.7.2.4`\n      - **Retune after component changes** `T.7.2.5`\n      - **Normalize component scales** `T.7.2.6`\n    - **Choose meta-model inputs** `T.7.3`\n      - decide: Which stacking feature change should I test? → Generate valid out-of-fold meta-features | Add auxiliary stacking features | Select a smaller meta-feature set\n      - desiderata · what fits this case?: Training meta-features include in-sample predictions or inconsistent fold assignments. · Additional aligned auxiliary outputs provide signal not captured by existing base scores. · The meta-feature pool has grown while validation stagnates or regresses.\n      - desiderata · added from expert visits: The meta-learner was trained on a different set of base-model features than what is being fed at inference time. · A previously tested base-model variant (e.g., LightGBM vs XGBoost) achieved higher scores and reverting to it may improve the stack. · A prior attempt to add a candidate meta-feature source (e.g., DeBERTa OOF predictions) failed to produce a valid submission. · Fold-specific or pre-trained model checkpoints are available for generating out-of-fold predictions for a candidate meta-feature source. · External artifact dependencies (pickled models, pre-computed CSVs) are causing load failures or stale/misaligned predictions. · A useful stacking signal column is being inadvertently dropped or excluded from the test-time meta-feature set.\n      - **Generate valid out-of-fold meta-features** `T.7.3.1`\n      - **Add auxiliary stacking features** `T.7.3.2`\n      - **Select a smaller meta-feature set** `T.7.3.3`\n    - **Map continuous scores to discrete labels** `T.7.4`\n      - decide: Which discretization rule should I compare? → Optimize ordinal cutpoints | Use simple clip-and-round | Match empirical target frequencies | Merge or threshold near-equal scores | Compare group-specific cutpoints | Handle degenerate bins and ties\n      - desiderata · what fits this case?: The ordinal metric is sensitive to cutpoints and representative held-out predictions are available. · Optimized thresholds have unstable or worse independent performance than simple rounding. · Known target frequencies are stable enough to support a distribution-matching comparison. · Continuous predictions correspond to a small set of repeated target levels. · Subgroups exhibit different residual-to-label mappings and are observable at prediction time. · Existing binning collapses a column or creates many artificial ties. · The checkpoint or ensemble changed since calibration was fitted.\n      - desiderata · added from expert visits: The evaluation metric is rank-based (e.g., Spearman), so discretization that creates ties or destroys orderings can only degrade performance.\n      - **Optimize ordinal cutpoints** `T.7.4.1`\n      - **Use simple clip-and-round** `T.7.4.2`\n      - **Match empirical target frequencies** `T.7.4.3`\n      - **Merge or threshold near-equal scores** `T.7.4.4`\n      - **Compare group-specific cutpoints** `T.7.4.5`\n      - **Handle degenerate bins and ties** `T.7.4.6`\n    - **Correct output semantics or bias** `T.7.5`\n      - decide: Which output correction should I test or repair? → Restore prediction units and activation | Align risk-score direction | Rescale probabilities or logits | Correct systematic prediction bias | Apply auxiliary or metadata corrections | Ablate an existing output transform\n      - desiderata · what fits this case?: Outputs have the wrong units, activation, range, or probability sum. · Some components rank risk in the opposite direction. · Valid probabilities show systematic confidence or per-class mass bias. · A systematic additive or reference-relative bias remains in valid predictions. · A high-precision auxiliary classifier or metadata rule identifies a predictable error subset. · A previously helpful post-processing step has not been reassessed after upstream changes. · The proposed global monotone rescaling cannot change the metric's ordering.\n      - desiderata · added from expert visits: The threshold or scope for applying the correction is too narrow (or too broad) to produce meaningful impact. · The proposed correction risks overfitting to a very small validation or test set. · The correction's strength hyperparameter (weight, boost, mask value) has not been validated or swept systematically. · The detection rule identifying which predictions to correct may itself be flawed, independent of the correction magnitude. · A control-flow bug (stray break, early return, or loop error) causes only a subset of models or corrections to be applied. · No validation or leaderboard feedback from prior correction values is available to guide the direction of the next adjustment. · The accumulated post-processing code has become too tangled with contradictory or duplicate rules to debug incrementally, warranting a clean rewrite.\n      - **Restore prediction units and activation** `T.7.5.1`\n      - **Align risk-score direction** `T.7.5.2`\n      - **Rescale probabilities or logits** `T.7.5.3`\n      - **Correct systematic prediction bias** `T.7.5.4`\n      - **Apply auxiliary or metadata corrections** `T.7.5.5`\n      - **Ablate an existing output transform** `T.7.5.6`\n    - **Choose inference-time averaging** `T.7.6`\n      - decide: Which repeated-view inference strategy should I test? → Average deterministic symmetry views | Average windows or resolutions | Compare stochastic forward-pass averaging | Disable unintended stochastic inference\n      - desiderata · what fits this case?: A deterministic flip or sensor symmetry preserves the label. · Multiple valid windows or compatible resolutions cover the same prediction target. · Repeated forward passes intentionally vary and prior stochastic-view evidence is promising. · Repeated passes should be identical but differ because training-mode layers or random transforms remain active. · The proposed augmentation changes signal meaning or previously hurt this branch.\n      - desiderata · added from expert visits: Repeated identical-code re-runs show substantial score variance (>0.01), confirming non-determinism is the dominant source of observed score changes. · A with-TTA leaderboard score already exists, providing a valid baseline for comparing against a without-TTA submission. · Prediction entropy measurement is planned or available to decide whether stochastic conditioning on uncertainty is worthwhile. · The model ensemble or preprocessing pipeline has changed since the last TTA ablation, potentially invalidating prior TTA results. · The current edit confounds the TTA change with another simultaneous change (e.g., re-enabling a disabled branch), preventing clean attribution. · A duplicated or redundant inference block exists that could cause double-counting of predictions.\n      - **Average deterministic symmetry views** `T.7.6.1`\n      - **Average windows or resolutions** `T.7.6.2`\n      - **Compare stochastic forward-pass averaging** `T.7.6.3`\n      - **Disable unintended stochastic inference** `T.7.6.4`\n  - **Make useful experiments feasible** `T.8`\n    - decide: Which execution change removes the current bottleneck? → Control peak resource use | Shorten experiment turnaround | Make pipeline changes reproducible\n    - desiderata · what fits this case?: Peak memory or per-batch throughput is the limiting resource. · Repeated trials recompute unchanged work or fail late after expensive training. · Hard-coded paths, duplicated model code, or unrecorded settings cause configuration drift.\n    - desiderata · added from expert visits: A code edit introduced a reference error (e.g., deleting or removing a variable still used downstream). · A debug/development flag or early-exit guard is preventing the full production pipeline from executing. · Full cross-validation with multiple seeds/folds is too slow for broad hyperparameter exploration. · The chosen algorithm variant (e.g., DART boosting) is significantly slower per iteration than alternatives, making current fold/seed counts infeasible for exploration. · Verbose debug/print statements clutter output and slow iteration when reviewing results. · A per-entity or per-row loop with repeated GPU-to-CPU transfers or format conversions dominates runtime. · CPU-based preprocessing (e.g., spectrogram computation) is a significant runtime bottleneck that could be GPU-accelerated. · Numerical precision settings during inference are a plausible source of score variation or degradation. · Model constructor parameters or backbone configuration do not match the checkpoint's training configuration. · The current notebook is a training notebook that must be converted to an inference/submission pipeline before test-set experiments can run. · The inference script does not persist intermediate outputs (logits, embeddings) needed for a planned downstream experiment. · Import errors or missing dependencies are the immediate cause of pipeline failure. · A metric computation or post-processing step called repeatedly (e.g., inside CV or optimization) dominates wall-clock time.\n    - **Control peak resource use** `T.8.1`\n      - decide: Which resource intervention fits the observed bottleneck? → Stream complete entities or prediction batches | Release sequential model state | Reduce stored feature precision | Tune inference batch size | Compare inference precision | Optimize expensive computation\n      - desiderata · what fits this case?: The full data or feature table cannot fit, but complete entities can be processed independently. · Memory accumulates across successive model loads. · Large feature matrices use wider dtypes than their range and required precision justify. · Peak memory occurs inside one forward pass and scales with batch size. · Model activations dominate memory and reduced precision is supported by the inference stack. · A metric, transform, or repeated device transfer dominates elapsed time.\n      - desiderata · added from expert visits: A previous memory-reduction intervention was already applied but did not resolve the resource failure. · A variable targeted for deletion is still referenced later in the pipeline, so removing it would cause an error or require recomputation. · Only a subset of columns is needed from the loaded file, and reading all columns unnecessarily inflates peak memory. · Intermediate DataFrames or arrays remain live in memory after they have been consumed (merged, aggregated, or copied), accumulating unnecessary RAM usage. · A single operation produces a large wide intermediate result that can be split into sequential smaller operations without changing the final output. · The GPU implementation of a computation has failed repeatedly and a working CPU fallback is available. · The observed failure is caused by a model configuration or architecture mismatch rather than a genuine resource bottleneck. · Python del and gc.collect() alone are insufficient to free GPU memory without an explicit framework cache-clearing call (e.g., torch.cuda.empty_cache()).\n      - **Stream complete entities or prediction batches** `T.8.1.1`\n      - **Release sequential model state** `T.8.1.2`\n      - **Reduce stored feature precision** `T.8.1.3`\n      - **Tune inference batch size** `T.8.1.4`\n      - **Compare inference precision** `T.8.1.5`\n      - **Optimize expensive computation** `T.8.1.6`\n    - **Shorten experiment turnaround** `T.8.2`\n      - decide: What can I reduce or reuse without invalidating the experiment? → Run a reduced end-to-end smoke test | Cache expensive reusable artifacts | Resume only unfinished training | Restore full production execution\n      - desiderata · what fits this case?: The current task is checking correctness and failures occur after expensive work. · Only downstream settings change while upstream features or predictions remain identical. · Some folds or training stages are complete but session limits prevent finishing the rest. · The next evaluated run must use the complete selected configuration but debug shortcuts remain enabled.\n      - desiderata · added from expert visits: The hyperparameter sweep has converged on a candidate value, so the next run should use the full/production configuration. · The expert is iterating over a single hyperparameter and needs fast per-trial feedback rather than full production runs. · The reduced-capacity smoke-test settings (e.g., low n_estimators) may be too aggressive, preventing early stopping or other mechanisms from finding a meaningful optimum and giving misleading directional signal. · Reducing the number of folds (e.g., from 10 to 5) still produces a valid end-to-end submission while substantially cutting training time. · A previous reduced-capacity smoke test completed the full pipeline successfully, confirming the pipeline is end-to-end functional at lower settings. · The full dataset is too large for fast iteration on EDA or feature engineering, so a smaller subset should be used. · A cleaned/filtered data subset can be persisted to disk to avoid re-running the full load-and-filter pipeline each iteration. · A smaller or lighter model variant completes training/inference faster, enabling quicker iteration on the pipeline. · A long-running operation lacks progress reporting, making it impossible to distinguish a hang from slow execution. · The public test set is very small, so fewer folds or a single fold suffices for generating valid predictions. · An environment-detectable signal (e.g., sample_submission row count) can automatically distinguish debug from production mode, enabling automatic shortcut toggling.\n      - **Run a reduced end-to-end smoke test** `T.8.2.1`\n      - **Cache expensive reusable artifacts** `T.8.2.2`\n      - **Resume only unfinished training** `T.8.2.3`\n      - **Restore full production execution** `T.8.2.4`\n    - **Make pipeline changes reproducible** `T.8.3`\n      - decide: Which code-organization change addresses the observed fragility? → Parameterize and separate model pipelines | Verify a cleanup or inference-only refactor | Pin configurations and artifacts | Make missing-component behavior explicit\n      - desiderata · what fits this case?: Adding model variants repeatedly requires editing duplicated code and shared globals. · Dead code or training-only paths obscure a stable inference pipeline. · Identical code can load different artifacts or settings across runs. · Some component files are missing or current exception handlers silently inject placeholders.\n      - desiderata · added from expert visits: A code-organization change has not yet been verified to produce a complete end-to-end submission. · Scores from repeated identical runs have not yet been compared to confirm the pipeline produces stable, reproducible results. · Upstream artifacts (checkpoints, datasets) may be refreshed between runs, causing score variation unrelated to code changes. · The edit mixes functional changes with non-functional cleanup, preventing isolation of which change caused any observed effect. · A known-good baseline score from the pre-refactor pipeline exists to serve as a parity target for the new pipeline. · Systematic variation of pipeline parameters (fold count, backbone size) is needed to isolate whether a score gap is due to single-component variance or a systematic pipeline bug.\n      - **Parameterize and separate model pipelines** `T.8.3.1`\n      - **Verify a cleanup or inference-only refactor** `T.8.3.2`\n      - **Pin configurations and artifacts** `T.8.3.3`\n      - **Make missing-component behavior explicit** `T.8.3.4`# [Select a trained artifact › Which checkpoint comparison should I perform?]   120 visits, 19 experts\n\noptions: Compare trained runs or folds (32) | Compare training stages or stopping rules (9) | Compare full-data and fold-trained weights (2)\n\ncheck first: E126 Several runs or fold checkpoints have matching architecture and preprocessing.  imp 0.50 → +Compare trained runs or folds  [first in 111/120 visits that checked it]\nthen:        E127 Artifacts differ mainly by training stage or stopping criterion.  imp 0.70 → +Compare training stages or stopping rules  [first in 7/78 visits that checked it]\nthen:        E128 Both full-data-trained and fold-trained artifacts are available.  imp 0.80 → +Compare full-data and fold-trained weights  [first in 2/10 visits that checked it]\nenough when:  top option >= 41% (lower quartile over 120 visits) or >= 11 points ahead; median 2 checks\ncome back:    after 'after a new best' (3/5); after '4+ scored steps without a new best' (2/5)  [5 returns, 2 improved the score]\n\nscores: LLM-guessed; top option matches the option taken in 63% of visits","exit_code":0,"status":"completed"}}
