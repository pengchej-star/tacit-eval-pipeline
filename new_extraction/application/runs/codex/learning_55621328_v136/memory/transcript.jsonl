{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"mkdir -p output\npython - <<'PY'\nfrom pathlib import Path\nimport json\nsource = Path('current_code.py').read_text()\nstart = source.index('\"'!python predict_separated.py '\"\\\\\\\\\\\\n')\n# Find the active call, excluding commented examples.\nstart = source.index('\\\\n\"'!python predict_separated.py '\"\\\\\\\\\\\\n') + 1\nend = source.index('\\\\n# %%', start)\nsource = source[:start] + '''# Restore the PET configuration associated with v129 (QWK 0.82845).\n# These five values are ordinal cutpoints, not checkpoint blend weights.\n# Keep the PET prompt, output scaling, vocabulary and checkpoint family together.\nimport json\nimport subprocess\nimport sys\n\npet_root = \\\"/kaggle/input/exp320-large-last\\\"\nsubprocess.run([\n    sys.executable, \\\"predict_pet2.py\\\",\n    \\\"--config\\\", f\\\"{pet_root}/config.yaml\\\",\n    \\\"--checkpoints\\\", json.dumps([\n        f\\\"{pet_root}/model_stage2_fold{fold}_last.pth\\\" for fold in range(4)\n    ]),\n    \\\"--save-name\\\", \\\"submission.csv\\\",\n    \\\"--weights\\\", json.dumps([\n        1.643716315906825, 2.6716739277111605, 3.5618693723268633,\n        4.236181497058755, 4.875353957753833\n    ]),\n    \\\"model.path=/kaggle/input/deberta-v3-large/deberta-v3-large\\\",\n    \\\"model.vocab_size=128003\\\",\n], check=True)\n''' + source[end:]\nstart = source.index('%%writefile predict_pet2.py')\nend = source.index('\\\\n# %%', start)\npet = source[start:end]\npet = pet.replace('model.load_state_dict(torch.load(checkpoint))', 'model.load_state_dict(torch.load(checkpoint, map_location=\\\"cpu\\\"), strict=True)')\nold = '''sub.loc[:, \\\"score\\\"] = optimized_rounder.predict(preds, np.array(json.loads(args.weights)))\n# sub.loc[:, \\\"score\\\"] = preds.round(0).astype(int)\nsub.to_csv(args.save_name, index=False)'''\nnew = '''# Predictions follow test.csv order; align explicitly to the submission IDs.\ncutpoints = np.asarray(json.loads(args.weights), dtype=np.float64)\nassert cutpoints.shape == (5,) and np.isfinite(cutpoints).all()\nassert np.all(np.diff(cutpoints) > 0), \\\"Ordinal cutpoints must increase\\\"\nassert preds.shape == (len(df),) and np.isfinite(preds).all()\nassert df[\\\"essay_id\\\"].is_unique and sub[\\\"essay_id\\\"].is_unique\nassert set(df[\\\"essay_id\\\"]) == set(sub[\\\"essay_id\\\"])\nprediction_frame = pd.DataFrame({\n    \\\"essay_id\\\": df[\\\"essay_id\\\"].to_numpy(),\n    \\\"score\\\": optimized_rounder.predict(preds, cutpoints).astype(np.int64),\n})\nsub = sub[[\\\"essay_id\\\"]].merge(\n    prediction_frame, on=\\\"essay_id\\\", how=\\\"left\\\", sort=False, validate=\\\"one_to_one\\\"\n)\nassert sub[\\\"score\\\"].notna().all() and sub[\\\"score\\\"].between(1, 6).all()\nsub[[\\\"essay_id\\\", \\\"score\\\"]].to_csv(args.save_name, index=False)'''\nassert old in pet\npet = pet.replace(old, new)\nsource = source[:start] + pet + source[end:]\nPath('output/revised_code.py').write_text(source)\nobservations = [\n('Does the local taxonomy include restoration after a measured regression?', 'yes', 'memory/taxonomy.md, T.1.3.1 identifies Restore the proven configuration.'),\n('Is quadratic weighted kappa the competition metric?', 'yes', 'task.md Evaluation and Summary from our notes specify QWK, higher is better.'),\n('Does the required submission contain integer scores from 1 through 6?', 'yes', 'task.md Data specifies the 1-6 score scale; Submission File requires essay_id,score in submission.csv.'),\n('Did v136 improve on v135?', 'no', 'history.md reports v135 0.80784 and v136 0.80526.'),\n('Did a previous PET configuration outperform the current version?', 'yes', 'history.md v129 enabled predict_pet2 with the final cutpoint changed to 4.87535 and scored 0.82845, versus v136 0.80526.'),\n('Did the recent simplified threshold configuration recover the earlier score?', 'no', 'history.md v133 scored 0.82503; v134 scored 0.80343; v135 reached only 0.80784. Scaling also changed in v134, so this is not an isolated threshold comparison.'),\n('Does the restoration guidance prioritize evidence of a regression?', 'yes', 'memory/attention/t-1-3-choose-a-response-to-an-unsuccessful-searc.md lists E22 as its first check.'),\n('Does compatibility guidance require consideration of checkpoint preprocessing?', 'yes', 'memory/attention/t-2-1-restore-model-and-input-compatibility.md identifies E31, inference transforms versus training transforms.'),\n('Does discretization guidance call for representative held-out predictions?', 'yes', 'memory/attention/t-7-4-map-continuous-scores-to-discrete-labels.md identifies E151 before optimizing ordinal cutpoints.'),\n('Is the active inference command using the small separated model?', 'yes', 'current_code.py lines 1081-1089 invoke predict_separated.py with four exp305_deberta-v3-small checkpoints.'),\n('Is a complete PET invocation retained in the current code?', 'yes', 'current_code.py lines 1168-1176 retain exp320-large-last config, four stage2 last checkpoints, DeBERTa-v3-large path, vocab_size=128003 and five precise cutpoints.'),\n('Are the five --weights values actually checkpoint blending coefficients?', 'no', 'predict_pet2.py averages checkpoints with np.mean; --weights is passed to OptimizedRounder.predict as ordinal thresholds. The other regression scripts do the same.'),\n('Does PET inference use a mask-token prompt?', 'yes', 'current_code.py predict_pet2.py tokenize constructs Student Writing Evaluate, the mask token, separator and essay, then returns mask_token_indexes.'),\n('Does PET inference map normalized predictions back to the score scale?', 'yes', 'current_code.py predict_pet2.py inference applies model output * 5 + 1 before checkpoint averaging.'),\n('Does PET inference load model parameters strictly?', 'yes', 'current_code.py predict_pet2.py calls load_state_dict without a strict override, so strict=True is the default.'),\n('Does the original PET output align predictions by essay_id?', 'no', 'current_code.py lines 470-474 read sample_submission.csv and assign predictions positionally, although the DataLoader follows test.csv order.'),\n('Does the local artifact-selection guidance recommend comparing compatible saved runs?', 'yes', 'memory/attention/t-6-3-select-a-trained-artifact.md identifies E126 and Compare trained runs or folds.'),\n('Can a PET-specific OOF calibration be verified from the supplied code?', 'no', 'The only active OOF loading logic shown in current_code.py is for exp306b_large_clean_last in predict_ordinal.py; predict_pet2.py uses supplied cutpoints. Competition data and artifacts are unavailable locally.'),\n]\nreport = {\n'observations': [dict(observation=o, result=r, evidence=e) for o,r,e in observations],\n'action_summary': 'Restore the retained four-fold exp320 PET inference configuration associated with v129 (0.82845), replacing the active small separated model (v136: 0.80526). Restore its precise ordinal cutpoints together with its large backbone and vocabulary override; preserve PET tokenization, output scaling, equal fold averaging and validation length. Make the active invocation fail on subprocess errors, load checkpoint tensors through CPU while keeping strict parameter matching, and explicitly join PET predictions to submission essay IDs with schema checks. No new threshold fitting or speculative blending is introduced without matching held-out predictions. Historical performance gives a credible improvement path, but the new leaderboard score cannot be measured without data.'\n}\nPath('output/report.json').write_text(json.dumps(report, indent=2) + '\\\\n')\nprint('Wrote both output files.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
