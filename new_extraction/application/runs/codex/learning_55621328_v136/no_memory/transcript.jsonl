urce = source[:start] + pet + source[end:]\nstart = source.index('\"'!python predict_separated.py '\"\\\\\\\\\\\\n  --config')\nend = source.index('\\\\n# %%', start)\nsource = source[:start] + '''# Restore the strongest scored experiment in the supplied history (v129).\n# Only use paths already referenced by this notebook; no downloads are needed.\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\npet_root = Path(\\\"/kaggle/input/exp320-large-last\\\")\npet_backbone = Path(\\\"/kaggle/input/deberta-v3-large/deberta-v3-large\\\")\npet_package = Path(\\\"/kaggle/input/aes2-code/kaggle-aes2-v3.2/kaggle-aes2-v3.2\\\")\npet_checkpoints = [pet_root / f\\\"model_stage2_fold{fold}_last.pth\\\" for fold in range(4)]\npet_required = [pet_root / \\\"config.yaml\\\", pet_backbone, pet_package, *pet_checkpoints]\nmissing_pet = [str(path) for path in pet_required if not path.exists()]\n\nif not missing_pet:\n    print(\\\"Using v129 PET large, four folds, with its original score thresholds.\\\")\n    command = [\n        sys.executable, \\\"predict_pet2.py\\\",\n        \\\"--config\\\", str(pet_root / \\\"config.yaml\\\"),\n        \\\"--checkpoints\\\", json.dumps([str(path) for path in pet_checkpoints]),\n        \\\"--save-name\\\", \\\"submission.csv\\\",\n        \\\"--weights\\\", json.dumps([\n            1.643716315906825, 2.6716739277111605, 3.5618693723268633,\n            4.236181497058755, 4.875353957753833,\n        ]),\n        f\\\"model.path={pet_backbone}\\\", \\\"model.vocab_size=128003\\\",\n        \\\"train.batch_size=4\\\",\n    ]\nelse:\n    # Some rerun environments attach only v136's small-model artifacts.\n    # Preserve a usable submission in that case, without loading partial folds.\n    print(\\\"PET artifacts unavailable; retaining v136 fallback:\\\", missing_pet)\n    small_root = Path(\\\"/kaggle/input/aes2-deberta-v3-small-fit-v5/model/exp305_deberta-v3-small\\\")\n    command = [\n        sys.executable, \\\"predict_separated.py\\\",\n        \\\"--config\\\", str(small_root / \\\"config.yaml\\\"),\n        \\\"--checkpoints\\\", json.dumps([\n            str(small_root / f\\\"model_fold{fold}.pth\\\") for fold in range(4)\n        ]),\n        \\\"--save-name\\\", \\\"submission.csv\\\",\n        \\\"--weights\\\", \\\"[1.65, 2.5, 3.5, 4.5, 5.0]\\\",\n        \\\"model.path=/kaggle/input/deberta-v3-small/deberta-v3-small\\\",\n    ]\nsubprocess.run(command, check=True)\n''' + source[end:]\nsource = source.replace('pd.read_csv(\\\"submission.csv\\\")\\\\n', '''submission = pd.read_csv(\\\"submission.csv\\\")\nsample = pd.read_csv(\\\"/kaggle/input/learning-agency-lab-automated-essay-scoring-2/sample_submission.csv\\\")\nassert list(submission.columns) == [\\\"essay_id\\\", \\\"score\\\"]\nassert len(submission) == len(sample)\nassert submission[\\\"essay_id\\\"].is_unique\nassert set(submission[\\\"essay_id\\\"]) == set(sample[\\\"essay_id\\\"])\nassert submission[\\\"score\\\"].notna().all()\nassert submission[\\\"score\\\"].isin(range(1, 7)).all()\nsubmission = sample[[\\\"essay_id\\\"]].merge(submission, on=\\\"essay_id\\\", validate=\\\"one_to_one\\\")\nsubmission[\\\"score\\\"] = submission[\\\"score\\\"].astype(int)\nsubmission.to_csv(\\\"submission.csv\\\", index=False)\nsubmission\n''')\nPath('output/revised_code.py').write_text(source)\nobservations = [\n    ('Is quadratic weighted kappa the target metric?', 'yes', 'task.md Evaluation specifies quadratic weighted kappa; higher is better.'),\n    ('Are the allowed essay scores integers from 1 through 6?', 'yes', 'task.md Data describes the 1–6 score scale; the submission example uses integer scores.'),\n    ('Must the final submission be named submission.csv?', 'yes', 'task.md Code Requirements specifies submission.csv, with essay_id and score in the submission example.'),\n    ('Does the supplied history contain a score above v136?', 'yes', 'history.md lists v136 at 0.80526 and v129 at 0.82845.'),\n    ('Did v129 activate the PET predictor?', 'yes', 'history.md v128 -> v129 enabled predict_pet2 and changed the last cut point from 5.3453 to 4.87535; score increased to 0.82845.'),\n    ('Did replacing calibrated thresholds with half-integer thresholds improve the recorded score?', 'no', 'history.md v133 -> v134 changed thresholds and disabled scaling; score fell from 0.82503 to 0.80343. This comparison does not isolate the two changes.'),\n    ('Did the switch to small checkpoints improve the recorded score?', 'no', 'history.md v135 -> v136 reports 0.80784 -> 0.80526 after switching to predict_separated with DeBERTa-v3-small.'),\n    ('Is the active prediction job a four-fold small-model ensemble?', 'yes', 'current_code.py active predict_separated invocation lists model_fold0.pth through model_fold3.pth under aes2-deberta-v3-small-fit-v5.'),\n    ('Does the existing code retain a PET large invocation consistent with v129?', 'yes', 'current_code.py commented predict_pet2 invocation includes exp320-large-last, all four stage2 last checkpoints, vocab_size=128003, and cut points ending in 4.875353957753833.'),\n    ('Does the PET predictor average continuous fold outputs before rounding?', 'yes', 'predict_pet2.py cell applies model output * 5 + 1, then np.mean(predictions, axis=0), then OptimizedRounder.predict.'),\n    ('Are the five values called weights used as checkpoint mixing coefficients?', 'no', 'The PET predictor passes args.weights to OptimizedRounder.predict; fold predictions receive equal weights in np.mean.'),\n    ('Does PET tokenization retain a prompt mask index?', 'yes', 'predict_pet2.py tokenize constructs the Student Writing Evaluate prompt and returns mask_token_indexes for the first mask token.'),\n    ('Does the original PET predictor sort essays by tokenized length?', 'no', 'The PET dataset is mapped and immediately reduced to input_ids, attention_mask, mask_token_indexes without sorting; the separated predictor sorts by length.'),\n    ('Does the original PET submission align predictions by essay_id?', 'no', 'predict_pet2.py assigns preds positionally to sample_submission.csv, assuming identical row order to test.csv.'),\n    ('Does PET checkpoint loading explicitly map tensors to CPU?', 'no', 'The original PET loop calls torch.load(checkpoint) without map_location.'),\n]\nreport = {\n    'observations': [dict(observation=q, result=r, evidence=e) for q, r, e in observations],\n    'action_summary': 'Prefer the existing four-fold exp320 PET large experiment with the exact score thresholds associated with v129 (0.82845 versus current 0.80526), preserving its prompt, tokenizer additions, output scaling, equal fold averaging, and strict checkpoint loading. Sort PET batches by length, use batch size 4, load checkpoint tensors through CPU, and align rounded predictions by essay_id in sample-submission order. Retain the original v136 small-model job only when the referenced PET artifacts are absent; that fallback is not expected to improve the score. Run the selected job with checked subprocess execution and validate the final submission schema, IDs, and integer score range. Artifact availability and leaderboard improvement cannot be verified without competition data; no training or inference was run.'\n}\nPath('output/report.json').write_text(json.dumps(report, indent=2) + '\\\\n')\nPY\npython output/_revise.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
