{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc 'ls -la && cat task.md && cat history.md && cat current_code.py'","aggregated_output":"# %%\nfrom tqdm.auto import tqdm\nimport pandas as pd\nimport polars as pl\nimport numpy as np\nimport argparse\nimport os\n\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import DataLoader\n\nfrom typing import Optional\nfrom typing import Tuple\nfrom typing import List\nfrom typing import Dict\nfrom typing import Any\n\n# %%\nDATA_DIR = \"/kaggle/input/hms-harmful-brain-activity-classification/\"\nSPEC_DIR = os.path.join(DATA_DIR, \"test_spectrograms/\")\nEEG_DIR = os.path.join(DATA_DIR, \"test_eegs/\")\n\ndf_train = pl.read_csv(os.path.join(DATA_DIR, \"train.csv\"))\ndf_test = pl.read_csv(os.path.join(DATA_DIR, \"test.csv\"))\nsample_submission = pl.read_csv(os.path.join(DATA_DIR, \"sample_submission.csv\"))\n\ndf_test.head()\n\n# %%\nimport torch\n\ndevice = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint('Using device:', device)\nprint()\n\n# %%\ndef load_model(path: str, model: nn.Module) -> nn.Module:\n    model.load_state_dict(torch.load(path, map_location = torch.device(\"cpu\"))[\"model_state_dict\"])\n    return model\n\n# %%\nimport sys\nsys.path.append(\"/kaggle/input/hms-models/\")\n\nfrom eeg_cnn_rnn_w1 import EegModel as EegModel0\nfrom eeg_cnn_rnn import EegModel as EegModel1\nfrom spc_cnn_rnn import SpectrogramModel\n\n# %%\nimport glob\nimport sys\n\nmodel_0_files = (\n    glob.glob(\"/kaggle/input/hms-models/new_distil/send_kaggle/*\") + \n    glob.glob(\"/kaggle/input/hms-models/new_fold/send_kaggle/*\")\n)\nmodel_2_files = (\n    glob.glob(\"/kaggle/input/hms-models/send_kaggle_spec/send_kaggle_spec/*\") \n)\n\n\"\"\"\nmodels_0 = [] \nfor fold_path in model_0_files:\n    model = EegModel0()\n    model = load_model(fold_path, model)\n    model = model.to(device)\n    models_0.append(model)\n\nmodels_1 = [] \nfor fold_path in glob.glob(\"/kaggle/input/hms-models/baseline_eeg_diff/*\"):\n    model_path = os.path.join(fold_path, \"model_best_val_g10.pt\")\n    model = EegModel1()\n    model = load_model(model_path, model)\n    model = model.to(device)\n    models_1.append(model)\n\"\"\"\n\nmodels_2 = []\nfor fold_path in model_2_files:\n    model = SpectrogramModel()\n    model = load_model(fold_path, model)\n    model = model.to(device)\n    models_2.append(model)\n\nlen(models_2)# + len(models_1)\n\n# %%\ndef MAD(signal, **kwargs):\n    \"\"\"Compute the robust standard deviation (MAD) of a signal.\"\"\"\n    scale_factor = 1.4826  # This is a constant for normal distribution\n    absolute_deviations = np.abs(signal - np.median(signal, **kwargs))\n    median_absolute_deviation = np.median(absolute_deviations, **kwargs)\n    robust_std = median_absolute_deviation * scale_factor\n    return robust_std\n\nfrom scipy.signal import welch\nfrom scipy.stats import linregress\nfrom scipy.signal import butter, filtfilt\n\ndef butter_filter(eeg_data, fs = 200, cutoff_freq = 22, order = 4, btype = \"lowpass\"):\n    b, a = butter(\n        N = order, \n        Wn = cutoff_freq / (0.5 * fs), \n        btype = btype, \n        analog = False\n    )\n\n    return filtfilt(b, a, eeg_data)\n\n# %%\nSTRIDE = 100\nWINDOW_SIZE = 500\nNOVERLAP = WINDOW_SIZE - STRIDE \nPARAMS = dict(\n    fs = 200, \n    window = (\"tukey\", 0.25), \n    nperseg = WINDOW_SIZE, \n    noverlap = NOVERLAP, \n    nfft = 1024, \n    detrend = \"constant\", \n    return_onesided = True, \n    scaling = \"density\", \n    axis = -1, \n    mode = \"psd\"\n)\n\n# %%\nimport scipy\n\ndef compute_spec(eeg: np.ndarray) -> np.ndarray:\n    freqs, _, Sxx = scipy.signal.spectrogram(eeg, **PARAMS)\n    valid_freq = (freqs >= 0.5) & (freqs <= 20)\n    return Sxx[valid_freq, :]\n\ndef compute_spec_eeg(a, b) -> np.ndarray:\n    eeg = a - b\n    eeg = butter_filter(eeg, cutoff_freq = np.array([0.25, 40.0]), order = 5, btype = \"bandpass\")\n    return eeg\n\ndef compute_spec_chain(df_eeg: pl.DataFrame) -> np.ndarray:\n    Fp1 = df_eeg[\"Fp1\"].to_numpy() \n    Fp2 = df_eeg[\"Fp2\"].to_numpy()\n    Fz  = df_eeg[\"Fz\"].to_numpy()\n    Cz  = df_eeg[\"Cz\"].to_numpy()\n    Pz  = df_eeg[\"Pz\"].to_numpy()\n    F3  = df_eeg[\"F3\"].to_numpy()\n    F4  = df_eeg[\"F4\"].to_numpy()\n    F7  = df_eeg[\"F7\"].to_numpy()\n    F8  = df_eeg[\"F8\"].to_numpy()\n    C3  = df_eeg[\"C3\"].to_numpy()\n    C4  = df_eeg[\"C4\"].to_numpy()\n    P3  = df_eeg[\"P3\"].to_numpy()\n    P4  = df_eeg[\"P4\"].to_numpy()\n    T3  = df_eeg[\"T3\"].to_numpy()\n    T4  = df_eeg[\"T4\"].to_numpy()\n    T5  = df_eeg[\"T5\"].to_numpy()\n    T6  = df_eeg[\"T6\"].to_numpy()\n    O1  = df_eeg[\"O1\"].to_numpy()\n    O2  = df_eeg[\"O2\"].to_numpy()\n    \n    ll = np.stack([(compute_spec_eeg(Fp1 , F7), compute_spec_eeg(F7 , T3), compute_spec_eeg(T3 , T5), compute_spec_eeg(T5 , O1))])\n    lp = np.stack([(compute_spec_eeg(Fp1 , F3), compute_spec_eeg(F3 , C3), compute_spec_eeg(C3 , P3), compute_spec_eeg(P3 , O1))])\n    rp = np.stack([(compute_spec_eeg(Fp2 , F4), compute_spec_eeg(F4 , C4), compute_spec_eeg(C4 , P4), compute_spec_eeg(P4 , O2))])\n    rl = np.stack([(compute_spec_eeg(Fp2 , F8), compute_spec_eeg(F8 , T4), compute_spec_eeg(T4 , T6), compute_spec_eeg(T6 , O2))])\n    chain = np.stack([ll, lp, rp, rl])[:, 0]\n    \n    mads = MAD(chain, axis = -1, keepdims = True)\n    mads = np.median(mads.reshape(-1))\n    chain = chain / (mads + 1e-5)\n    \n    outer = []\n    for i in range(4):\n        inner = []\n        for j in range(4):\n            inner.append(compute_spec(chain[i, j]))\n        outer.append(inner)\n        \n    chain = np.array(outer)\n    chain = np.log(chain.clip(np.exp(-4), np.exp(8)))\n    chain = chain.mean(axis = 1, keepdims = True)\n    \n    return chain\n\n# %%\ndef compute_spec_from_file(filepath: str) -> np.ndarray:\n    df_eeg = pl.read_parquet(filepath).fill_null(0)\n    chain = compute_spec_chain(df_eeg)\n    return chain\n\n# %%\nimport numpy as np\nimport math\n\nfrom typing import Union\nfrom typing import Tuple\nfrom typing import List\n\n\ndef bin_array(\n    array, \n    bin_size, \n    axis = -1, \n    pad_dir = \"symmetric\", \n    mode = \"edge\", \n    return_padding = False,\n    **padding_kwargs\n) -> Union[np.ndarray, Tuple[np.ndarray, List]]:\n    \"\"\"Given an array and bin size, bins the array along an arbitrary axis into\n    bins of size `bin_size`. It will perform padding if the array does not split\n    up into equal bin sizes. \n\n    Args:\n        array (np.ndarray): The input array.\n        bin_size (int): The size of each bin.\n        axis (int): The axis to bin the array along. Default is -1.\n        pad_dir (str): The padding direction. One of `left`, `right`, or\n            `symmetric` (default).\n        return_padding (bool): Option to return the padding width used. \n        mode (str): The padding mode. See the NumPy documentation for options. \n\n    Returns:\n        np.ndarray: The binned array where the number of bins is first. That is,\n            the shape will be `(..., n_bins, bin_size, ...)`.\n\n    \"\"\"\n    if axis == -1:\n        axis = array.ndim - 1\n\n    curr_len = array.shape[axis]\n    n_bins = math.ceil(curr_len / bin_size)\n    new_len = n_bins * bin_size\n\n    new_shape = list(array.shape)\n    new_shape[axis] = n_bins\n    new_shape.insert(axis + 1, bin_size)\n\n    # Perform padding if curr_len does not equal new_len.\n    padding = [(0, 0)] * array.ndim\n    if curr_len != new_len:\n        if pad_dir == \"left\":\n            pad_l = new_len - curr_len\n            pad_r = 0\n        elif pad_dir == \"right\":\n            pad_l = 0\n            pad_r = new_len - curr_len\n        else:\n            pad_l = (new_len - curr_len) // 2\n            pad_r = (new_len - curr_len) - pad_l\n\n        padding[axis] = (pad_l, pad_r)\n        array = np.pad(array, padding, mode = mode, **padding_kwargs)\n\n    array = array.reshape(new_shape)\n\n    if return_padding:\n        return array, padding\n\n    return array\n\n# %%\ndef compute_eeg(eeg: np.ndarray) -> np.ndarray:\n    eeg = butter_filter(eeg, cutoff_freq = np.array([0.25, 50]), btype = \"bandpass\")\n    eeg = bin_array(eeg, bin_size = 4, mode = \"reflect\").mean(axis = -1)\n    return eeg\n    \ndef compute_eeg_chain(df_eeg: pl.DataFrame) -> np.ndarray:\n    Fp1 = df_eeg[\"Fp1\"].to_numpy()\n    Fp2 = df_eeg[\"Fp2\"].to_numpy()\n    F3  = df_eeg[\"F3\"].to_numpy()\n    F4  = df_eeg[\"F4\"].to_numpy()\n    F7  = df_eeg[\"F7\"].to_numpy()\n    F8  = df_eeg[\"F8\"].to_numpy()\n    C3  = df_eeg[\"C3\"].to_numpy()\n    C4  = df_eeg[\"C4\"].to_numpy()\n    P3  = df_eeg[\"P3\"].to_numpy()\n    P4  = df_eeg[\"P4\"].to_numpy()\n    T3  = df_eeg[\"T3\"].to_numpy()\n    T4  = df_eeg[\"T4\"].to_numpy()\n    T5  = df_eeg[\"T5\"].to_numpy()\n    T6  = df_eeg[\"T6\"].to_numpy()\n    O1  = df_eeg[\"O1\"].to_numpy()\n    O2  = df_eeg[\"O2\"].to_numpy()\n    \n    ll = np.stack([(compute_eeg(Fp1 - F7), compute_eeg(F7 - T3), compute_eeg(T3 - T5), compute_eeg(T5 - O1))])\n    lp = np.stack([(compute_eeg(Fp1 - F3), compute_eeg(F3 - C3), compute_eeg(C3 - P3), compute_eeg(P3 - O1))])\n    rp = np.stack([(compute_eeg(Fp2 - F4), compute_eeg(F4 - C4), compute_eeg(C4 - P4), compute_eeg(P4 - O2))])\n    rl = np.stack([(compute_eeg(Fp2 - F8), compute_eeg(F8 - T4), compute_eeg(T4 - T6), compute_eeg(T6 - O2))])\n    \n    chain = np.stack([ll, lp, rp, rl])[:, 0]\n    \n    return chain\n\ndef compute_eeg_from_file(filepath: str) -> np.ndarray:\n    df_eeg = pl.read_parquet(filepath).fill_null(0)\n    chain = compute_eeg_chain(df_eeg)\n    \n    return chain\n\n# %%\nLABELS = [\n    \"seizure_vote\", \n    \"lpd_vote\", \n    \"gpd_vote\", \n    \"lrda_vote\", \n    \"grda_vote\", \n    \"other_vote\"\n]\n\n# %%\n# Option for better printing.\nnp.set_printoptions(formatter = {\"all\": lambda x: f\"{x:0.3f}\"})\n\ndef proc_0(x):\n    x = x.copy()\n    \n    x = x - x.mean(axis = -1, keepdims = True)\n    x = x / (np.mean(x.std(axis = -1)) + 1e-5)\n    x = x.reshape(4, 4, 2_500)\n    \n    return x\n\ndef proc_1(x):\n    x = x.copy()\n    \n    x = x - x.mean(axis = -1, keepdims = True)\n    x = x / (x.std(axis = -1, keepdims = True) + 1e-5)\n    x = x.reshape(16, 1, 2_500)\n    \n    return x\n\n\ndef proc_2(spec):\n    spec = spec - spec.mean(axis = (-1, -2), keepdims = True)\n    spec = spec / (spec.std(axis = (-1, -2), keepdims = True) + 1e-5)\n    return spec\n\n\ndef flip_h(eeg):\n    temp0 = eeg[0].copy()\n    temp1 = eeg[1].copy()\n\n    eeg[0] = eeg[3]\n    eeg[1] = eeg[2]\n    eeg[3] = temp0\n    eeg[2] = temp1\n    \n    return eeg\n\ndef flip_v(eeg):\n    temp0 = eeg[:, 0].copy()\n    temp1 = eeg[:, 1].copy()\n\n    eeg[:, 0] = eeg[:, 3]\n    eeg[:, 1] = eeg[:, 2]\n    eeg[:, 3] = temp0\n    eeg[:, 2] = temp1\n    \n    return eeg\n\ndef tta(x):\n    x0 = x.copy().reshape(4, 4, -1)\n    x1 = x.copy().reshape(4, 4, -1)\n    x2 = x.copy().reshape(4, 4, -1)\n\n    x0 = flip_v(x0).reshape(16, 1, -1)\n    x1 = flip_h(x1).reshape(16, 1, -1)\n    x2 = flip_v(flip_h(x2)).reshape(16, 1, -1)\n    \n    return x, x0, x1, x2\n\n@torch.no_grad()\ndef gen_ensemble_pred(df_row: pl.DataFrame) -> np.ndarray:\n    eeg_id = df_row[\"eeg_id\"].item()\n    filepath = os.path.join(EEG_DIR, f\"{eeg_id}.parquet\")\n    \n    preds = []\n    \n    spec = compute_spec_from_file(filepath)\n    spec = proc_2(spec)\n    spec = torch.Tensor(spec).to(device).unsqueeze(0)\n    \n    \"\"\"\n    x = compute_eeg_from_file(filepath)\n    x[np.isnan(x) | np.isinf(x)] = 0\n\n    x0 = proc_0(x)\n    x1 = proc_1(x)\n    \n    x11, x12, x13, x14 = tta(x1)\n    x01, x02, x03, x04 = tta(x0)\n    \n    x11 = torch.Tensor(x11).to(device).unsqueeze(0)\n    x12 = torch.Tensor(x12).to(device).unsqueeze(0)\n    x13 = torch.Tensor(x13).to(device).unsqueeze(0)\n    x14 = torch.Tensor(x14).to(device).unsqueeze(0)\n    \n    x01 = torch.Tensor(x01).to(device).unsqueeze(0)\n    x02 = torch.Tensor(x02).to(device).unsqueeze(0)\n    x03 = torch.Tensor(x03).to(device).unsqueeze(0)\n    x04 = torch.Tensor(x04).to(device).unsqueeze(0)\n\n    for model in models_0:\n        model.eval()\n        preds.append(model(x01).exp().cpu().detach().numpy().reshape(-1))\n        preds.append(model(x02).exp().cpu().detach().numpy().reshape(-1))\n        preds.append(model(x03).exp().cpu().detach().numpy().reshape(-1))\n        preds.append(model(x04).exp().cpu().detach().numpy().reshape(-1))\n        \n    for model in models_1:\n        model.eval()\n        preds.append(model(x11).exp().cpu().detach().numpy().reshape(-1))\n        preds.append(model(x12).exp().cpu().detach().numpy().reshape(-1))\n        preds.append(model(x13).exp().cpu().detach().numpy().reshape(-1))\n        preds.append(model(x14).exp().cpu().detach().numpy().reshape(-1))\n    \"\"\"\n    \n    for model in models_2:\n        model.eval()\n        preds.append(model(spec).exp().cpu().detach().numpy().reshape(-1))\n        \n    for pred in preds:\n        print(pred)\n        \n    preds = np.mean(preds, axis = 0)\n    preds = preds / preds.sum()\n    return preds\n\n# %%\nfrom tqdm.auto import tqdm\n    \npreds_final = []\nfor i in range(len(df_test)):\n    pred = gen_ensemble_pred(df_test[i])\n    preds_final.append(pred)\n\n# %%\ndf_sub = pd.DataFrame({\"eeg_id\": df_test[\"eeg_id\"].to_list()})\ndf_sub[LABELS] = preds_final\ndf_sub.to_csv(\"submission.csv\", index = False)\ndf_sub\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"mkdir -p output\npython - <<'PY'\nfrom pathlib import Path\nimport json\nsrc = Path('current_code.py').read_text()\n# Keep the existing raw-EEG transforms and their checkpoint-specific layouts.\nbinning = src[src.index('def bin_array('):src.index('# %%\\\\ndef compute_eeg(')]\neeg = src[src.index('def compute_eeg('):src.index('# %%\\\\nLABELS =')]\neeg = eeg.replace('pl.read_parquet(filepath).fill_null(0)', 'pl.read_parquet(filepath).fill_null(0).fill_nan(0)')\neeg = eeg.replace('    chain = compute_eeg_chain(df_eeg)\\\\n', '    # Repair infinities before filtering: one nonfinite value can poison a lead.\\\\n    df_eeg = df_eeg.with_columns([\\\\n        pl.when(pl.col(name).is_infinite()).then(0).otherwise(pl.col(name)).alias(name)\\\\n        for name in EEG_COLUMNS\\\\n    ])\\\\n    chain = compute_eeg_chain(df_eeg)\\\\n')\npreprocessing = src[src.index('def proc_0('):src.index('\\\\ndef proc_2(')]\ncode = '''# %%\nfrom tqdm.auto import tqdm\nimport pandas as pd\nimport polars as pl\nimport numpy as np\nimport os\nimport sys\nimport glob\nimport math\nfrom typing import Union, Tuple, List\n\nimport torch\nimport torch.nn as nn\nfrom scipy.signal import butter, filtfilt\n\n# %%\nDATA_DIR = \\\"/kaggle/input/hms-harmful-brain-activity-classification/\\\"\nSPEC_DIR = os.path.join(DATA_DIR, \\\"test_spectrograms/\\\")\nEEG_DIR = os.path.join(DATA_DIR, \\\"test_eegs/\\\")\n\ndf_train = pl.read_csv(os.path.join(DATA_DIR, \\\"train.csv\\\"))\ndf_test = pl.read_csv(os.path.join(DATA_DIR, \\\"test.csv\\\"))\nsample_submission = pl.read_csv(os.path.join(DATA_DIR, \\\"sample_submission.csv\\\"))\n\nLABELS = [\n    \\\"seizure_vote\\\", \\\"lpd_vote\\\", \\\"gpd_vote\\\",\n    \\\"lrda_vote\\\", \\\"grda_vote\\\", \\\"other_vote\\\"\n]\nEEG_COLUMNS = [\n    \\\"Fp1\\\", \\\"Fp2\\\", \\\"F3\\\", \\\"F4\\\", \\\"F7\\\", \\\"F8\\\", \\\"C3\\\", \\\"C4\\\",\n    \\\"P3\\\", \\\"P4\\\", \\\"T3\\\", \\\"T4\\\", \\\"T5\\\", \\\"T6\\\", \\\"O1\\\", \\\"O2\\\"\n]\n\n# %%\ndevice = torch.device(\\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\")\nprint(\\\"Using device:\\\", device)\n\n\ndef load_model(path: str, model: nn.Module) -> nn.Module:\n    checkpoint = torch.load(path, map_location=torch.device(\\\"cpu\\\"))\n    model.load_state_dict(checkpoint[\\\"model_state_dict\\\"])\n    return model.to(device).eval()\n\n# %%\nsys.path.append(\\\"/kaggle/input/hms-models/\\\")\nfrom eeg_cnn_rnn_w1 import EegModel as EegModel0\nfrom eeg_cnn_rnn import EegModel as EegModel1\n\n# Restore the raw-EEG ensemble supported by v13's leaderboard result.\n# Preserve equal per-checkpoint weighting and each family's original inputs.\nmodel_0_files = sorted(set(\n    glob.glob(\\\"/kaggle/input/hms-models/new_distil/send_kaggle/*\\\") +\n    glob.glob(\\\"/kaggle/input/hms-models/new_fold/send_kaggle/*\\\")\n))\nmodel_0_files = [path for path in model_0_files if os.path.isfile(path)]\nmodel_1_files = [\n    os.path.join(path, \\\"model_best_val_g10.pt\\\")\n    for path in sorted(glob.glob(\\\"/kaggle/input/hms-models/baseline_eeg_diff/*\\\"))\n    if os.path.isdir(path)\n]\nassert model_0_files, \\\"No eeg_cnn_rnn_w1 checkpoints found\\\"\nassert model_1_files, \\\"No baseline_eeg_diff fold directories found\\\"\nfor path in model_1_files:\n    if not os.path.isfile(path):\n        raise FileNotFoundError(path)\n\nmodels_0 = [load_model(path, EegModel0()) for path in model_0_files]\nmodels_1 = [load_model(path, EegModel1()) for path in model_1_files]\nprint(f\\\"Loaded {len(models_0)} w1 and {len(models_1)} baseline EEG models\\\")\n\n# %%\ndef butter_filter(eeg_data, fs=200, cutoff_freq=22, order=4, btype=\\\"lowpass\\\"):\n    b, a = butter(\n        N=order, Wn=cutoff_freq / (0.5 * fs), btype=btype, analog=False\n    )\n    return filtfilt(b, a, eeg_data)\n\n# %%\n'''+binning+'# %%\\\\n'+eeg+'# %%\\\\n'+preprocessing+'''\n# %%\n@torch.no_grad()\ndef gen_ensemble_pred(df_row: pl.DataFrame) -> np.ndarray:\n    eeg_id = df_row[\\\"eeg_id\\\"].item()\n    filepath = os.path.join(EEG_DIR, f\\\"{eeg_id}.parquet\\\")\n    x = compute_eeg_from_file(filepath)\n    x = np.nan_to_num(x, nan=0.0, posinf=0.0, neginf=0.0)\n    if x.shape \"'!= (4, 4, 2500):\n        raise ValueError(f\"Unexpected EEG shape for {eeg_id}: {x.shape}\")\n\n    x0 = torch.as_tensor(proc_0(x), dtype=torch.float32, device=device).unsqueeze(0)\n    x1 = torch.as_tensor(proc_1(x), dtype=torch.float32, device=device).unsqueeze(0)\n\n    # Identity inference: the flip TTA in v14 worsened the recorded score.\n    preds = []\n    for models, inputs in ((models_0, x0), (models_1, x1)):\n        for model in models:\n            log_probs = model(inputs).float().reshape(-1)\n            if log_probs.numel() != len(LABELS) or not torch.isfinite(log_probs).all():\n                raise ValueError(f\"Invalid model output for EEG {eeg_id}\")\n            # Equivalent to exp(log_probs) for normalized log-probabilities,\n            # while keeping the computation stable for very small outputs.\n            preds.append(torch.softmax(log_probs, dim=-1).cpu().numpy())\n\n    pred = np.mean(np.stack(preds), axis=0, dtype=np.float64)\n    pred = np.clip(pred, 1e-12, 1.0)\n    return pred / pred.sum()\n\n# %%\npreds_final = []\nfor i in tqdm(range(len(df_test)), desc=\"Predicting EEGs\"):\n    preds_final.append(gen_ensemble_pred(df_test[i]))\n\n# %%\ndf_sub = pd.DataFrame({\"eeg_id\": df_test[\"eeg_id\"].to_list()})\ndf_sub[LABELS] = np.asarray(preds_final).reshape(-1, len(LABELS))\n# Use the sample file'\"'s ID order and exact column order.\nsubmission_order = pd.DataFrame({\\\"eeg_id\\\": sample_submission[\\\"eeg_id\\\"].to_list()})\ndf_sub = submission_order.merge(df_sub, on=\\\"eeg_id\\\", how=\\\"left\\\", validate=\\\"one_to_one\\\")\ndf_sub = df_sub[sample_submission.columns]\nprobabilities = df_sub[LABELS].to_numpy()\nassert np.isfinite(probabilities).all(), \\\"Submission contains nonfinite probabilities\\\"\nassert (probabilities >= 0).all(), \\\"Submission contains negative probabilities\\\"\nassert np.allclose(probabilities.sum(axis=1), 1.0, atol=1e-6)\ndf_sub.to_csv(\\\"submission.csv\\\", index=False)\ndf_sub\n'''\nPath('output/revised_code.py').write_text(code)\nobs = [\n('Is lower KL divergence the competition objective?', 'yes', 'task.md Evaluation and metric direction specify KL divergence with lower scores better.'),\n('Must submission rows contain six probabilities summing to one?', 'yes', 'task.md Submission File specifies eeg_id plus six vote columns and unit row sums.'),\n('Is v15 the best recorded version?', 'no', 'history.md reports v15 at 0.43907, while v13 reached 0.30219.'),\n('Did restoring the second EEG family improve v13 over v12?', 'yes', 'history.md: v12 scored 0.32099; adding baseline_eeg_diff in v13 scored 0.30219.'),\n('Did flip augmentation improve the recorded leaderboard score?', 'no', 'history.md: v13 to v14 changed 0.30219 to 0.31017 after adding flips.'),\n('Did the spectrogram revision improve the recorded leaderboard score?', 'no', 'history.md: v14 to v15 changed 0.31017 to 0.43907.'),\n('Does the active v15 loader include the raw EEG models?', 'no', 'current_code.py wraps models_0 and models_1 loading in a triple-quoted string; only models_2 is loaded.'),\n('Does active v15 inference blend EEG predictions with spectrogram predictions?', 'no', 'current_code.py gen_ensemble_pred places raw EEG inference inside a triple-quoted string; only models_2 predictions reach the active average.'),\n('Are the original raw EEG checkpoint paths retained in v15?', 'yes', 'current_code.py lists new_distil/send_kaggle, new_fold/send_kaggle and baseline_eeg_diff/model_best_val_g10.pt.'),\n('Do the two raw EEG families use different normalization?', 'yes', 'current_code.py proc_0 divides by mean lead standard deviation; proc_1 divides each lead by its own standard deviation.'),\n('Does proc_0 expect a different input layout from proc_1?', 'yes', 'current_code.py reshapes proc_0 to (4,4,2500) and proc_1 to (16,1,2500).'),\n('Does the existing TTA preserve proc_0 layout for its flipped variants?', 'no', 'current_code.py tta reshapes each flipped variant to (16,1,-1), including variants from proc_0.'),\n('Does raw EEG preprocessing explicitly repair NaNs before filtering?', 'no', 'current_code.py compute_eeg_from_file calls fill_null(0) only; explicit numpy NaN cleanup occurs after filtering in the disabled inference block.'),\n('Does the supplied EEG pipeline use four-sample averaging after bandpass filtering?', 'yes', 'current_code.py compute_eeg uses a 0.25-50 Hz bandpass followed by bin_array(bin_size=4).mean(axis=-1).'),\n('Does the original raw EEG inference treat model outputs as log probabilities?', 'yes', 'current_code.py disabled models_0 and models_1 inference calls model(x).exp().'),\n('Does the original submission explicitly align rows to sample_submission?', 'no', 'current_code.py builds df_sub directly in df_test order and never uses the loaded sample_submission for alignment.')\n]\nreport = {'observations': [{'observation':a,'result':b,'evidence':c} for a,b,c in obs], 'action_summary': 'Restore the two-family raw EEG ensemble using the retained new_distil, new_fold, and baseline_eeg_diff checkpoint paths, with equal checkpoint weights and the existing family-specific preprocessing. Remove the spectrogram-only route and flip TTA: both changes worsened recorded scores, whereas v13 reached 0.30219. Repair nonfinite raw values before filtering, use stable normalized probability averaging, and enforce sample-submission ordering and valid probability rows. No training or inference was run; improvement remains unverified without competition data.'}\nPath('output/report.json').write_text(json.dumps(report, indent=2)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
