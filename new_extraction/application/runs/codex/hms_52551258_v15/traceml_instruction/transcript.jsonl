{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"mkdir -p output\npython - <<'PY'\nfrom pathlib import Path\nimport json\nsrc = Path('current_code.py').read_text()\nsrc = src.replace('from spc_cnn_rnn import SpectrogramModel\\\\n', '')\nstart = src.index('# %%\\\\nimport glob')\nend = src.index('# %%\\\\nimport numpy as np\\\\nimport math', start)\nsrc = src[:start] + '''# %%\nimport glob\n\n# Restore the two EEG families used by the strongest recorded version (v13).\n# Keep each checkpoint's input layout and normalization unchanged.\nmodel_0_files = sorted(set(\n    glob.glob(\\\"/kaggle/input/hms-models/new_distil/send_kaggle/*\\\") +\n    glob.glob(\\\"/kaggle/input/hms-models/new_fold/send_kaggle/*\\\")\n))\nmodel_0_files = [path for path in model_0_files if os.path.isfile(path)]\nmodel_1_files = sorted(\n    os.path.join(path, \\\"model_best_val_g10.pt\\\")\n    for path in glob.glob(\\\"/kaggle/input/hms-models/baseline_eeg_diff/*\\\")\n    if os.path.isdir(path)\n)\nif not model_0_files or not model_1_files:\n    raise FileNotFoundError(\\\"Both pretrained EEG model families are required.\\\")\n\nmodels_0 = []\nfor model_path in model_0_files:\n    model = load_model(model_path, EegModel0()).to(device).eval()\n    models_0.append(model)\n\nmodels_1 = []\nfor model_path in model_1_files:\n    model = load_model(model_path, EegModel1()).to(device).eval()\n    models_1.append(model)\n\nprint(f\\\"Loaded {len(models_0)} w1 EEG models and {len(models_1)} baseline EEG models\\\")\n\n# %%\nfrom scipy.signal import butter, filtfilt\n\n\ndef butter_filter(eeg_data, fs=200, cutoff_freq=22, order=4, btype=\\\"lowpass\\\"):\n    b, a = butter(\n        N=order,\n        Wn=cutoff_freq / (0.5 * fs),\n        btype=btype,\n        analog=False,\n    )\n    return filtfilt(b, a, eeg_data)\n\n''' + src[end:]\nsrc = src.replace('''    df_eeg = pl.read_parquet(filepath).fill_null(0)\n    chain = compute_eeg_chain(df_eeg)\n    \n    return chain''', '''    df_eeg = pl.read_parquet(filepath).fill_null(0)\n    # Clean each electrode before differencing/filtering: filtfilt propagates\n    # a single NaN through an entire lead. Match the existing zero-null policy.\n    df_eeg = pl.DataFrame({\n        name: np.nan_to_num(df_eeg[name].to_numpy(), nan=0.0, posinf=0.0, neginf=0.0)\n        for name in df_eeg.columns\n    })\n    chain = compute_eeg_chain(df_eeg)\n    return np.nan_to_num(chain, nan=0.0, posinf=0.0, neginf=0.0)''')\nstart = src.index('\\\\ndef proc_2(')\nend = src.index('# %%\\\\nfrom tqdm.auto import tqdm', start)\nsrc = src[:start] + '''\n@torch.inference_mode()\ndef gen_ensemble_pred(df_row: pl.DataFrame) -> np.ndarray:\n    eeg_id = df_row[\\\"eeg_id\\\"].item()\n    filepath = os.path.join(EEG_DIR, f\\\"{eeg_id}.parquet\\\")\n    x = compute_eeg_from_file(filepath)\n\n    # Identity-only inference: channel-flip TTA degraded v14 relative to v13.\n    # In particular, w1 requires (batch, 4, 4, 2500), whereas the baseline\n    # requires (batch, 16, 1, 2500). Do not reshape either family's input for TTA.\n    x0 = torch.as_tensor(proc_0(x), dtype=torch.float32, device=device).unsqueeze(0)\n    x1 = torch.as_tensor(proc_1(x), dtype=torch.float32, device=device).unsqueeze(0)\n    preds = []\n    for models, inputs in ((models_0, x0), (models_1, x1)):\n        for model in models:\n            # These checkpoints return log probabilities. Softmax is equivalent\n            # to exp followed by normalization and is numerically stable.\n            pred = torch.softmax(model(inputs).float(), dim=-1)\n            pred = pred.cpu().numpy().reshape(-1)\n            if pred.shape \"'!= (len(LABELS),) or not np.isfinite(pred).all():\n                raise ValueError(f\"Invalid model prediction for EEG {eeg_id}\")\n            preds.append(pred)\n\n    # Equal checkpoint weights reproduce the successful v13 ensemble rule.\n    # Average probabilities, not log probabilities, for the forward KL metric.\n    pred = np.mean(np.stack(preds).astype(np.float64), axis=0)\n    pred = np.maximum(pred, 1e-15)\n    return pred / pred.sum()\n\n'\"''' + src[end:]\nsrc = src.replace('for i in range(len(df_test)):', 'for i in tqdm(range(len(df_test)), desc=\\\"EEG ensemble inference\\\"):')\nsrc = src.replace('''df_sub[LABELS] = preds_final\ndf_sub.to_csv''', '''df_sub[LABELS] = preds_final\nif not np.isfinite(df_sub[LABELS].to_numpy()).all():\n    raise ValueError(\\\"Submission contains non-finite probabilities\\\")\nif not np.allclose(df_sub[LABELS].sum(axis=1), 1.0, atol=1e-7):\n    raise ValueError(\\\"Submission probabilities must sum to one\\\")\nif df_sub[\\\"eeg_id\\\"].duplicated().any():\n    raise ValueError(\\\"Submission must contain one row per EEG\\\")\ndf_sub.to_csv''')\nPath('output/revised_code.py').write_text(src)\nobservations = [\n    ('Is lower KL divergence the competition objective?', 'yes', 'task.md Evaluation specifies KL divergence; its metric direction is lower is better.'),\n    ('Does the submission require six class probabilities per EEG?', 'yes', 'task.md Submission File lists seizure_vote, lpd_vote, gpd_vote, lrda_vote, grda_vote, other_vote.'),\n    ('Must each submission probability row sum to one?', 'yes', 'task.md explicitly states that rows must sum to one.'),\n    ('Is v13 the best recorded leaderboard result?', 'yes', 'history.md reports v13 at 0.30219, lower than every other listed score including v11 at 0.30250.'),\n    ('Did adding channel-flip TTA improve the recorded score?', 'no', 'history.md reports v13 at 0.30219 and v14 at 0.31017 after adding flips.'),\n    ('Did the v15 spectrogram change improve the recorded score?', 'no', 'history.md reports v14 at 0.31017 and v15 at 0.43907.'),\n    ('Is EEG model loading active in current_code.py?', 'no', 'The models_0 and models_1 loading loops are inside a triple-quoted string.'),\n    ('Does the active v15 prediction path ensemble EEG models with spectrogram models?', 'no', 'gen_ensemble_pred has the EEG inference block inside a triple-quoted string; only the models_2 loop executes.'),\n    ('Are the two EEG families supplied with distinct normalization schemes?', 'yes', 'proc_0 divides by the mean of lead standard deviations; proc_1 divides each lead by its own standard deviation.'),\n    ('Does the existing TTA preserve the w1 input layout for every variant?', 'no', 'proc_0 returns (4, 4, 2500), but tta reshapes all flipped variants to (16, 1, -1).'),\n    ('Does EEG loading explicitly sanitize NaNs before filtering?', 'no', 'compute_eeg_from_file only calls fill_null(0); the disabled inference block replaces NaN/Inf after compute_eeg_chain has already run filtfilt.'),\n    ('Does the script contain a patient-grouped OOF validation pipeline?', 'no', 'current_code.py loads pretrained checkpoints and performs test inference; it contains no fold construction or OOF evaluation. The planning guidance was considered, but pretrained fold provenance and data are unavailable, so no validation or training is fabricated.'),\n    ('Is an AGENTS.md file present within the inspected workspace depth?', 'no', 'find . -maxdepth 2 -type f -name AGENTS.md returned no paths.'),\n]\nreport = {\n    'observations': [dict(observation=q, result=a, evidence=e) for q,a,e in observations],\n    'action_summary': 'Restore the two-family pretrained EEG ensemble behind the best recorded v13 result: load new_distil/new_fold w1 checkpoints plus baseline_eeg_diff model_best_val_g10.pt checkpoints, with the original family-specific preprocessing and equal checkpoint probability averaging. Remove the active spectrogram-only branch and the empirically harmful channel-flip TTA. Sanitize non-finite electrode values before filtering, set evaluation mode once, and validate finite normalized submission probabilities. Preserve Kaggle paths and submission.csv format. No training or inference was run; leaderboard improvement is supported by the supplied history, not a new measurement.'\n}\nPath('output/report.json').write_text(json.dumps(report, indent=2) + '\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
