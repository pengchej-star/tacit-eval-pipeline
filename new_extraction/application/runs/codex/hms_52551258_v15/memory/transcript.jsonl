{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"mkdir -p output\npython - <<'PY'\nfrom pathlib import Path\nimport json\nsrc = Path('current_code.py').read_text()\n# Retain the existing notebook cells and raw EEG feature implementation.\nsrc = src.replace('from spc_cnn_rnn import SpectrogramModel\\\\n', '')\na = src.index('# %%\\\\nimport glob')\nb = src.index('# %%\\\\ndef MAD', a)\nsrc = src[:a] + '''# %%\nimport glob\n\n# Restore the two complementary EEG architectures used by the best recorded run.\n# Preserve equal weight per checkpoint, including both w1 training recipes.\ndef checkpoint_files(pattern):\n    paths = sorted(path for path in glob.glob(pattern) if os.path.isfile(path))\n    if not paths:\n        raise FileNotFoundError(f\\\"No model checkpoints found: {pattern}\\\")\n    return paths\n\nmodel_0_files = (\n    checkpoint_files(\\\"/kaggle/input/hms-models/new_distil/send_kaggle/*\\\") +\n    checkpoint_files(\\\"/kaggle/input/hms-models/new_fold/send_kaggle/*\\\")\n)\nmodel_1_dirs = sorted(\n    path for path in glob.glob(\\\"/kaggle/input/hms-models/baseline_eeg_diff/*\\\")\n    if os.path.isdir(path)\n)\nif not model_1_dirs:\n    raise FileNotFoundError(\\\"No baseline_eeg_diff fold directories found\\\")\nmodel_1_files = [\n    os.path.join(path, \\\"model_best_val_g10.pt\\\") for path in model_1_dirs\n]\nfor path in model_1_files:\n    if not os.path.isfile(path):\n        raise FileNotFoundError(path)\n\nmodels_0 = [load_model(path, EegModel0()).to(device).eval()\n            for path in model_0_files]\nmodels_1 = [load_model(path, EegModel1()).to(device).eval()\n            for path in model_1_files]\nprint(f\\\"Loaded {len(models_0)} w1 checkpoints and {len(models_1)} baseline checkpoints\\\")\n\n''' + src[b:]\na = src.index('# %%\\\\ndef MAD')\nb = src.index('def butter_filter', a)\nsrc = src[:a] + '# %%\\\\nfrom scipy.signal import butter, filtfilt\\\\n\\\\n' + src[b:]\na = src.index('# %%\\\\nSTRIDE')\nb = src.index('# %%\\\\nimport numpy as np\\\\nimport math', a)\nsrc = src[:a] + src[b:]\n# Sanitize each electrode before filtering, so a single NaN cannot erase a lead.\nsrc = src.replace('def compute_eeg_chain(df_eeg: pl.DataFrame) -> np.ndarray:\\\\n', '''def compute_eeg_chain(df_eeg: pl.DataFrame) -> np.ndarray:\n    # Keep the original zero-fill policy, extending it to NaN/Inf before filtfilt.\n    def lead(name):\n        return np.nan_to_num(df_eeg[name].to_numpy().astype(np.float64),\n                             nan=0.0, posinf=0.0, neginf=0.0)\n\n''')\nimport re\nsrc = re.sub(r'df_eeg\\\\[\\\"([A-Za-z0-9]+)\\\"\\\\]\\\\.to_numpy\\\\(\\\\)', r'lead(\\\"\\\\1\\\")', src)\na = src.index('\\\\ndef proc_2')\nb = src.index('# %%\\\\nfrom tqdm.auto import tqdm', a)\nsrc = src[:a] + '''\n@torch.no_grad()\ndef gen_ensemble_pred(df_row: pl.DataFrame) -> np.ndarray:\n    eeg_id = df_row[\\\"eeg_id\\\"].item()\n    filepath = os.path.join(EEG_DIR, f\\\"{eeg_id}.parquet\\\")\n    x = compute_eeg_from_file(filepath)\n    x = np.nan_to_num(x, nan=0.0, posinf=0.0, neginf=0.0)\n    if x.shape \"'!= (4, 4, 2500):\n        raise ValueError(f\"Unexpected EEG shape for {eeg_id}: {x.shape}\")\n\n    # The architectures require distinct shapes and normalization statistics.\n    # Use only the original view: the recorded flip-TTA experiment regressed.\n    x0 = torch.as_tensor(proc_0(x), dtype=torch.float32, device=device).unsqueeze(0)\n    x1 = torch.as_tensor(proc_1(x), dtype=torch.float32, device=device).unsqueeze(0)\n\n    preds = []\n    for models, inputs in ((models_0, x0), (models_1, x1)):\n        for model in models:\n            output = model(inputs).float().reshape(-1)\n            if output.numel() != len(LABELS) or not torch.isfinite(output).all().item():\n                raise ValueError(f\"Invalid model output for EEG {eeg_id}\")\n            # Checkpoints emit log probabilities; softmax is normalized exp,\n            # evaluated stably without overflow. Average in probability space.\n            preds.append(torch.softmax(output, dim=0).cpu().numpy())\n\n    pred = np.mean(np.asarray(preds, dtype=np.float64), axis=0)\n    pred = np.maximum(pred, 1e-12)\n    return pred / pred.sum()\n\n'\"''' + src[b:]\nsrc = src.replace('for i in range(len(df_test)):', 'for i in tqdm(range(len(df_test)), desc=\\\"EEG ensemble inference\\\"):')\na = src.index('# %%\\\\ndf_sub = pd.DataFrame')\nsrc = src[:a] + '''# %%\ndf_sub = pd.DataFrame({\\\"eeg_id\\\": df_test[\\\"eeg_id\\\"].to_list()})\ndf_sub[LABELS] = np.asarray(preds_final)\n# Align explicitly with the required submission identifiers and column order.\nsubmission_ids = pd.DataFrame({\\\"eeg_id\\\": sample_submission[\\\"eeg_id\\\"].to_list()})\ndf_sub = submission_ids.merge(df_sub, on=\\\"eeg_id\\\", how=\\\"left\\\", validate=\\\"one_to_one\\\", sort=False)\ndf_sub = df_sub[[\\\"eeg_id\\\"] + LABELS]\nprobabilities = df_sub[LABELS].to_numpy()\nif not np.isfinite(probabilities).all():\n    raise ValueError(\\\"Missing or nonfinite submission probabilities\\\")\nif not (probabilities >= 0).all() or not np.allclose(probabilities.sum(axis=1), 1.0, atol=1e-6):\n    raise ValueError(\\\"Submission rows must be probability distributions\\\")\ndf_sub.to_csv(\\\"submission.csv\\\", index=False)\ndf_sub\n'''\nPath('output/revised_code.py').write_text(src)\nobs = []\ndef add(statement, result, evidence):\n    obs.append({'observation': statement, 'result': result, 'evidence': evidence})\nadd('Does the decision taxonomy include restoring missing model contributions?', 'yes', 'memory/taxonomy.md, T.2.2.2, explicitly lists Restore missing model contributions.')\nadd('Is lower KL divergence the competition objective?', 'yes', 'task.md identifies KL divergence as the metric and states lower is better.')\nadd('Does the submission require six probabilities summing to one per eeg_id?', 'yes', 'task.md Evaluation lists the six vote columns and requires each row to sum to one.')\nadd('Is v15 worse than v14 on the recorded leaderboard?', 'yes', 'history.md gives v15=0.43907 and v14=0.31017.')\nadd('Is v13 the best recorded version?', 'yes', 'The lowest score listed in history.md is v13=0.30219; v11 is 0.30250.')\nadd('Did adding the second EEG family improve the v12 result?', 'yes', 'history.md records 0.32099 for v12 and 0.30219 for v13 after restoring baseline_eeg_diff.')\nadd('Did flip TTA improve the recorded v13 result?', 'no', 'history.md records the flip-TTA change at v14 with score 0.31017, worse than v13=0.30219.')\nadd('Does v15 actively load the two raw EEG model families?', 'no', 'current_code.py encloses the models_0 and models_1 loading loops in a triple-quoted string.')\nadd('Does v15 actively include raw EEG predictions in the ensemble?', 'no', 'current_code.py gen_ensemble_pred encloses all models_0 and models_1 forward passes in a triple-quoted string.')\nadd('Is the active v15 predictor spectrogram-only?', 'yes', 'Only models_2 is actively loaded and only model(spec) contributes to preds in current_code.py.')\nadd('Are the original EEG checkpoint paths retained in the supplied code?', 'yes', 'current_code.py retains new_distil/send_kaggle/*, new_fold/send_kaggle/* and baseline_eeg_diff/*/model_best_val_g10.pt.')\nadd('Do the retained EEG families require different preprocessing?', 'yes', 'proc_0 uses mean channel standard deviation with shape (4,4,2500); proc_1 uses per-channel standard deviation with shape (16,1,2500).')\nadd('Does the retained EEG pipeline downsample filtered bipolar channels?', 'yes', 'compute_eeg applies a 0.25-50 Hz Butterworth bandpass then averages bins of four; compute_eeg_chain constructs 16 bipolar channels.')\nadd('Does flip TTA preserve the proc_0 tensor shape for every view?', 'no', 'tta returns x unchanged but reshapes the other three views to (16,1,-1), whereas proc_0 returns (4,4,2500).')\nadd('Does the original input pipeline replace NaN values before filtering?', 'no', 'compute_eeg_from_file uses fill_null(0), not NaN/Inf replacement; the inactive EEG inference block sanitizes x only after compute_eeg_from_file.')\nadd('Does the original loader reject an empty checkpoint discovery?', 'no', 'The glob loops in current_code.py have no nonempty assertions before averaging predictions.')\nadd('Does the existing pipeline average probabilities?', 'yes', 'current_code.py uses model(...).exp() followed by np.mean(preds, axis=0) and normalization.')\nadd('Does the original submission explicitly align to sample-submission identifiers?', 'no', 'current_code.py writes df_test eeg_id order directly; sample_submission is loaded but unused.')\nadd('Do the relevant memory entries support checking restoration after regressions?', 'yes', 'Read attention/t-1-3-choose-a-response-to-an-unsuccessful-searc.md and t-6-2-choose-ensemble-membership.md: compare prior configurations and restore complementary members when warranted. The observed history supports restoration, though repeated-run variance is unavailable.')\nadd('Do the relevant memory entries prioritize tracing absent predictions?', 'yes', 'Read attention/t-2-2-locate-a-data-flow-defect.md: check missing model contributions. The inactive EEG loading and inference blocks directly match that situation.')\nadd('Do the relevant memory entries recommend checking input compatibility?', 'yes', 'Read attention/t-2-1-restore-model-and-input-compatibility.md and t-7-6-choose-inference-time-averaging.md: check preprocessing contracts and validity of alternate views; the retained proc_0/proc_1 contracts and TTA reshape issue are relevant.')\nadd('Are competition artifacts available locally for validation?', 'no', 'The current directory listing contains task.md, current_code.py, history.md, prompt.txt and memory/, but no competition data or model checkpoints; the task also explicitly states data are unavailable.')\nreport = {'observations': obs, 'action_summary': 'Restore the two complementary raw-EEG model families using the retained checkpoint paths and their separate normalization/shape contracts, replacing the spectrogram-only execution that coincided with the v15 regression. Remove flip TTA, which worsened the recorded score and changes the w1 input shape, while retaining equal checkpoint probability averaging to approximate the best recorded v13 configuration (0.30219). Sanitize nonfinite electrode values before filtering, use stable normalized exponentiation, fail explicitly for missing checkpoints, and align and validate submission probabilities. This is a history-supported recovery, not a measured new score; no training or inference was run.'}\nPath('output/report.json').write_text(json.dumps(report, indent=2) + '\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
