{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '521,800p' current_code.py\"","aggregated_output":"        x = self.dropout(x)\n        x = self.fc(x)\n\n        x =torch.softmax(x,-1)\n\n        if CFG['flip']:\n            ans= (x[:bs,...]+x[bs:,...])/2.\n        else:\n            ans=x\n            \n        return ans\n\n\n\n# %%\n\nclass Transform(nn.Module):\n    def __init__(self, ):\n        super().__init__()\n\n        self.wave_transform = torchaudio.transforms.Spectrogram(n_fft=512, hop_length=50, power=1)\n\n        \n\n    def forward(self, x):\n        bs = x.size(0)\n\n\n        image = self.wave_transform(x)\n        image = torch.log10(image)\n        image = torch.clip(image, min=0)\n\n        n, c, h, w = image.size()\n        image=image[:,:,:int(40/100*h),:]\n\n        image = torch.reshape(image,shape=[n,2,-1,w])\n\n\n        x1=image[:,0:1,...]\n        x2=image[:,1:2,...]\n\n        image=torch.cat([x1,x2],dim=-1)\n\n        image=torch.cat([image,image,image],dim=1)\n\n        return image\n\n\n\n\nclass NetOneImage(nn.Module):\n    def __init__(self, num_classes=1):\n        super().__init__()\n\n        self.preprocess = Transform()\n\n        self.model = timm.create_model('efficientnet_b5',\n                                       pretrained=False,\n                                       in_chans=3)\n\n        self.fc = nn.Linear(2048, 6, bias=True)\n        # self.wave_encoder = ResNet1D(inp_ch=42, block=ResNetBlock1D, layers=[2, 2, 4, 2], num_classes=1)\n\n        # weight_init(self.fc)\n        self.dropout=nn.Dropout(0.5)\n\n        self.avg=nn.AdaptiveAvgPool2d(1)\n\n\n    def forward(self, x):\n        # do preprocess\n        bs = x.size(0)\n\n        x= self.preprocess(x)\n        \n        if CFG['flip']:\n            x_flip=torch.flip(x, [-1])\n            x=torch.cat([x,x_flip],dim=0)\n            \n            \n        x = self.model.forward_features(x)\n        x = self.avg(x)\n        if CFG['flip']:\n            x = x.view(2*bs, -1)\n        else:\n            x = x.view(bs, -1)\n        x = self.dropout(x)\n\n        x = self.fc(x)\n        x =torch.softmax(x,-1)\n        \n        if CFG['flip']:\n            ans= (x[:bs,...]+x[bs:,...])/2.\n        else:\n            ans=x\n            \n        return ans\n\n\n# %%\n\nclass Transform3d(nn.Module):\n    def __init__(self, ):\n        super().__init__()\n\n        self.wave_transform = torchaudio.transforms.Spectrogram(n_fft=512,\n                                                                \n                                                                hop_length=50,\n                                                                power=1)\n\n        self.am2db= torchaudio.transforms.AmplitudeToDB(stype='magnitude',top_db=80)\n\n        self.resizer=nn.UpsamplingBilinear2d(size=[160,320])\n    def forward(self, x):\n        bs = x.size(0)\n\n\n        image = self.wave_transform(x)\n        # image = self.am2db(image)\n        image = torch.log10(image)\n        image = torch.clip(image, min=0)\n\n        n, c, h, w = image.size()\n        image = image[:, :, :int(20 / 100 * h + 30), :]\n\n\n\n\n        return image\n\n\nclass Model(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.net = create_r2plus1d()\n        # n_features = self.net._fc.in_features\n        # self.net._fc = nn.Linear(in_features=n_features, out_features=6, bias=True)\n        \n    def forward(self, x):\n        out = self.net(x)\n\n        return out\n\n\nclass Net3d(nn.Module):\n    def __init__(self, num_classes=1):\n        super().__init__()\n\n        self.preprocess = Transform3d()\n\n        self.model = Model()\n\n        self.pool=nn.AdaptiveAvgPool3d(1)\n        self.fc = nn.Linear(2048, 6, bias=True)\n\n    def forward(self, x):\n        bs = x.size(0)\n\n        x= self.preprocess(x)\n\n        x = torch.unsqueeze(x,dim=1)\n\n        x = torch.cat([x,x,x],dim=1)\n        if CFG['flip']:\n            x_flip=torch.flip(x, [-1])\n            x=torch.cat([x,x_flip],dim=0)\n            \n        x = self.model(x)\n\n        x = self.pool(x)\n        if CFG['flip']:\n            x = x.view(2*bs, -1)\n        else:\n            x = x.view(bs, -1)\n            \n        \n        x= self.fc(x)\n        \n        x =torch.softmax(x,-1)\n        \n        if CFG['flip']:\n            ans= (x[:bs,...]+x[bs:,...])/2.\n        else:\n            ans=x\n            \n        return ans\n\n\n\n\n# %%\n\nclass Transformx3d(nn.Module):\n    def __init__(self, ):\n        super().__init__()\n\n        self.wave_transform = torchaudio.transforms.Spectrogram(n_fft=512,                                      \n                                                                hop_length=25,\n                                                                power=1)\n\n        self.am2db= torchaudio.transforms.AmplitudeToDB(stype='magnitude',top_db=80)\n\n        self.resizer=nn.UpsamplingBilinear2d(size=[160,320])\n    def forward(self, x):\n        bs = x.size(0)\n\n\n        image = self.wave_transform(x)\n        # image = self.am2db(image)\n        image = torch.log10(image)\n        image = torch.clip(image, min=0)\n\n        n, c, h, w = image.size()\n        image = image[:, :, :int(40 / 100 * h+10 ), :]\n\n\n\n        return image\n\n\nclass Modelx3d(nn.Module):\n    def __init__(self):\n        super().__init__()\n        model_name = \"x3d_l\"\n        self.net = create_x3d(input_clip_length=16,\n        input_crop_size=312,\n        depth_factor=5.0,)\n        \n        # self.net.blocks[5]=nn.Identity()\n        # self.net.avgpool = nn.Identity()\n        self.net.blocks[5].dropout=nn.Identity()\n        self.net.blocks[5].proj = nn.Identity()\n        self.net.blocks[5].activation = nn.Identity()\n        self.net.blocks[5].output_pool = nn.Identity()\n    def forward(self, x):\n\n        x = self.net(x)\n\n        return x\n\n\n\nclass Netx3d(nn.Module):\n    def __init__(self, num_classes=1):\n        super().__init__()\n\n        self.preprocess = Transformx3d()\n\n        self.model = Modelx3d()\n\n        self.pool=nn.AdaptiveAvgPool3d(1)\n        self.fc = nn.Linear(2048, 6, bias=True)\n\n    def forward(self, x):\n        bs = x.size(0)\n\n        x= self.preprocess(x)\n\n        x = torch.unsqueeze(x,dim=1)\n\n        x = torch.cat([x,x,x],dim=1)\n        if CFG['flip']:\n            x_flip=torch.flip(x, [-1])\n            x=torch.cat([x,x_flip],dim=0)\n            \n        x = self.model(x)\n\n#         x = self.pool(x)\n        if CFG['flip']:\n            x = x.view(2*bs, -1)\n        else:\n            x = x.view(bs, -1)\n            \n        \n        x= self.fc(x)\n        \n        x =torch.softmax(x,-1)\n        \n        if CFG['flip']:\n            ans= (x[:bs,...]+x[bs:,...])/2.\n","exit_code":0,"status":"completed"}}
