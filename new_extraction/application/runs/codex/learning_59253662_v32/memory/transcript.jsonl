sear_write_formula(x)).alias(f'{essay_part}_linsear_write_formula'))\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_no_punc').map_elements(lambda x: textstat.gunning_fog(x)).alias(f'{essay_part}_gunning_fog'))\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_no_punc').map_elements(lambda x: textstat.text_standard(x, float_output=True)).alias(f'{essay_part}_text_standard'))\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_no_punc').map_elements(lambda x: textstat.spache_readability(x)).alias(f'{essay_part}_spache_readability'))\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_no_punc').map_elements(lambda x: textstat.reading_time(x)).alias(f'{essay_part}_reading_time'))\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_no_punc').map_elements(lambda x: textstat.mcalpine_eflaw(x)).alias(f'{essay_part}_mcalpine_eflaw'))\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_no_punc').map_elements(lambda x: textstat.syllable_count(x)).alias(f'{essay_part}_syllable_count'))\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_no_punc').map_elements(lambda x: textstat.lexicon_count(x)).alias(f'{essay_part}_lexicon_count'))\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_no_punc').map_elements(lambda x: textstat.monosyllabcount(x)).alias(f'{essay_part}_monosyllab_count'))\n\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_no_punc').map_elements(sentiment_analysis).alias(f'{essay_part}_sentiment_score'))\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_sentiment_score').list.get(0).alias(f'{essay_part}_subj_score'))\n    tmp = tmp.with_columns(pl.col(f'{essay_part}_sentiment_score').list.get(1).alias(f'{essay_part}_pol_score'))\n    \n    tmp = tmp.with_columns(pl.col(essay_part).map_elements(lambda x: len(x)).alias(f'{essay_part}_len'))\n    tmp = tmp.with_columns(pl.col(essay_part).map_elements(lambda x: len(x.split('.'))).alias(f'{essay_part}_sentence_cnt'),\n                    pl.col(essay_part).map_elements(lambda x: len(x.split(' '))).alias(f'{essay_part}_word_cnt'),)\n    \n    tmp = tmp.drop([f'{essay_part}_sentiment_score'])\n    torch.cuda.empty_cache()\n\n    return tmp\n\n# feature_eng\n\ndef Essay_Parts_Eng(train_tmp, essay_part):\n    paragraph_fea = [f'{essay_part}_len',f'{essay_part}_sentence_cnt',f'{essay_part}_word_cnt']\n    paragraph_fea2 = [f'{essay_part}_vocab_num', f'{essay_part}_quotes_num', f'{essay_part}_flesch_reading_ease',\n                      f'{essay_part}_flesch_kincaid_grade', f'{essay_part}_smog_index', f'{essay_part}_coleman_liau_index',\n                      f'{essay_part}_automated_readability_index', f'{essay_part}_dale_chall_readability_score' , f'{essay_part}_difficult_words',\n                      f'{essay_part}_linsear_write_formula', f'{essay_part}_gunning_fog', f'{essay_part}_text_standard',\n                      f'{essay_part}_spache_readability', f'{essay_part}_reading_time', f'{essay_part}_mcalpine_eflaw',\n                      f'{essay_part}_syllable_count', f'{essay_part}_lexicon_count', f'{essay_part}_monosyllab_count',\n                      f'{essay_part}_subj_score', f'{essay_part}_pol_score'] + paragraph_fea\n   \n\n    aggs = [\n        *[pl.col(essay_part).filter(pl.col(f'{essay_part}_len') >= i).count().alias(f'{essay_part}_>{i}_cnt') for i in [0, 50,75,100,125,150,175,200,250,300,350,400,500,600,700] ], \n        *[pl.col(essay_part).filter(pl.col(f'{essay_part}_len') <= i).count().alias(f'{essay_part}_<{i}_cnt') for i in [25,49]], \n        *[pl.col(fea).max().alias(f\"{fea}_max\") for fea in paragraph_fea2],\n        *[pl.col(fea).mean().alias(f\"{fea}_mean\") for fea in paragraph_fea2],\n        *[pl.col(fea).min().alias(f\"{fea}_min\") for fea in paragraph_fea2],\n        *[pl.col(fea).sum().alias(f\"{fea}_sum\") for fea in paragraph_fea2],\n        *[pl.col(fea).first().alias(f\"{fea}_first\") for fea in paragraph_fea2],\n        *[pl.col(fea).last().alias(f\"{fea}_last\") for fea in paragraph_fea2],\n        *[pl.col(fea).kurtosis().alias(f\"{fea}_kurtosis\") for fea in paragraph_fea2],\n        *[pl.col(fea).quantile(0.25).alias(f\"{fea}_q1\") for fea in paragraph_fea2],\n        *[pl.col(fea).quantile(0.75).alias(f\"{fea}_q3\") for fea in paragraph_fea2],\n        ]\n    aggs = [agg for agg in aggs if agg is not None]\n    df = train_tmp.group_by(['essay_id'], maintain_order=True).agg(aggs).sort(\"essay_id\")\n    df = df.to_pandas()\n    return df\n\n\n# %%\n\"\"\"tmp_para = Essay_Parts_Preprocess(train, 'paragraph', mode= 'train')\ntrain_feats_para = Essay_Parts_Eng(tmp_para, 'paragraph')\n\ntmp_intro = Essay_Parts_Preprocess(train, 'introduction', mode= 'train')\ntrain_feats_intro = Essay_Parts_Eng(tmp_intro, 'introduction')\ntrain_feats_intro.drop(['essay_id'],axis=1,inplace= True)\n\n\ntmp_body = Essay_Parts_Preprocess(train, 'body', mode= 'train')\ntrain_feats_body = Essay_Parts_Eng(tmp_body, 'body')\ntrain_feats_body.drop(['essay_id'],axis=1,inplace= True)\n\n\ntmp_concl = Essay_Parts_Preprocess(train, 'conclusion', mode= 'train')\ntrain_feats_concl = Essay_Parts_Eng(tmp_concl, 'conclusion')\ntrain_feats_concl.drop(['essay_id'],axis=1,inplace= True)\n\ntrain_feats = pd.concat([train_feats_para, train_feats_intro, train_feats_body, train_feats_concl], axis =1)\n\"\"\"\n\n\"\"\"import time\n\nstart_time = time.time()\ntmp_para = Essay_Parts_Preprocess(train, 'paragraph', mode= 'train')\nend_time = time.time()\n\nprint(f\"Time taken to extract Paragraph features: {end_time - start_time} seconds\")\n\ntrain_feats = Essay_Parts_Eng(tmp_para, 'paragraph')\n\ntrain_feats['score'] = train['score']\n\nfeature_names = list(filter(lambda x: x not in ['essay_id','score'], train_feats.columns))\nprint('Features Number: ',len(feature_names))\ntrain_feats.head(3)\"\"\"\n\n# %%\ndef Sentence_Preprocess(tmp):\n    tmp = tmp.with_columns(pl.col('full_text').map_elements(dataPreprocessing).str.split(by=\".\").alias(\"sentence\"))\n    tmp = tmp.explode('sentence')\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.flesch_reading_ease(x)).alias('sentence_flesch_reading_ease')) \n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.flesch_kincaid_grade(x)).alias('sentence_flesch_kincaid_grade'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.smog_index(x)).alias('sentence_smog_index'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.coleman_liau_index(x)).alias('sentence_coleman_liau_index'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.automated_readability_index(x)).alias('sentence_automated_readability_index'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.dale_chall_readability_score(x)).alias('sentence_dale_chall_readability_score'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.difficult_words(x)).alias('sentence_difficult_words'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.linsear_write_formula(x)).alias('sentence_linsear_write_formula'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.gunning_fog(x)).alias('sentence_gunning_fog'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.text_standard(x, float_output=True)).alias('sentence_text_standard'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.spache_readability(x)).alias('sentence_spache_readability'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.reading_time(x)).alias('sentence_reading_time'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.mcalpine_eflaw(x)).alias('sentence_mcalpine_eflaw'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.syllable_count(x)).alias('sentence_syllable_count'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.lexicon_count(x)).alias('sentence_lexicon_count'))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: textstat.monosyllabcount(x)).alias('sentence_monosyllab_count'))\n\n\n    texts = tmp['sentence'].to_list()\n    docs = list(nlp.pipe(texts, disable=['tokenizer'], batch_size = 100))  # Disable tokenizer since texts are already tokenized\n\n    # Add POS and NER counts\n    tmp = tmp.with_columns([pl.Series([pos_tag_counts(doc)[0] for doc in docs]).alias('sentence_noun_counts')])\n    tmp = tmp.with_columns([pl.Series([pos_tag_counts(doc)[1] for doc in docs]).alias('sentence_verb_counts')])\n    tmp = tmp.with_columns([pl.Series([pos_tag_counts(doc)[2] for doc in docs]).alias('sentence_pron_counts')])\n    tmp = tmp.with_columns([pl.Series([pos_tag_counts(doc)[3] for doc in docs]).alias('sentence_adj_counts')])\n    tmp = tmp.with_columns([pl.Series([pos_tag_counts(doc)[4] for doc in docs]).alias('sentence_adv_counts')])\n\n    tmp = tmp.with_columns([pl.Series([named_entity_count(doc) for doc in docs]).alias('sentence_ner_counts')])\n\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: len(x)).alias(\"sentence_len\"))\n    tmp = tmp.with_columns(pl.col('sentence').map_elements(lambda x: len(x.split(' '))).alias(\"sentence_word_cnt\")) \n    \n\n    return tmp\n\n# feature_eng\nsentence_fea1 = ['sentence_len','sentence_word_cnt']\nsentence_fea = ['sentence_flesch_reading_ease', 'sentence_flesch_kincaid_grade', 'sentence_smog_index', 'sentence_coleman_liau_index', \n                'sentence_automated_readability_index', 'sentence_dale_chall_readability_score', 'sentence_difficult_words', 'sentence_linsear_write_formula', \n                'sentence_gunning_fog', 'sentence_text_standard', 'sentence_spache_readability',  'sentence_reading_time', 'sentence_mcalpine_eflaw', \n                'sentence_syllable_count', 'sentence_lexicon_count', 'sentence_monosyllab_count', 'sentence_noun_counts','sentence_verb_counts', \n                'sentence_pron_counts', 'sentence_adj_counts', 'sentence_adv_counts', 'sentence_ner_counts'] + sentence_fea1\ndef Sentence_Eng(train_tmp):\n    aggs = [\n        *[pl.col('sentence').filter(pl.col('sentence_len') >= i).count().alias(f\"sentence_>{i}_cnt\") for i in [0,15,50,100,150,200,250,300] ], \n        *[pl.col('sentence').filter(pl.col('sentence_len') <= i).count().alias(f\"sentence_<{i}_cnt\") for i in [15,50] ], \n        *[pl.col(fea).max().alias(f\"{fea}_max\") for fea in sentence_fea],\n    - desiderata · what fits this case?: A correctly implemented backbone or learner has plateaued across local tuning. · A minimal head or fusion rule discards useful backbone or branch information. · The active learner is a tree model with capacity or convergence problems. · The active component is neural and its optimization or loss is suspect.\n    - desiderata · added from expert visits: A bug or mismatch in the model definition or weight loading prevents the new component from running or functioning correctly. · The auxiliary binning head (num_bins > 1) has been tested across configurations with inconsistent or mixed results. · Top public solutions or domain knowledge indicate a different model family (e.g., 1D CNN/RNN on raw signals) is effective for this task. · A model-fitting change from a prior edit has not yet been scored, so evaluation should precede further changes. · Recent iterations have focused on backbone/architecture swaps rather than optimization or loss changes. · A different deep learning framework is available and could enable architectures not easily built in the current one. · A newer or different pretrained checkpoint version is available for the same model architecture. · A newly introduced tree or ensemble model has not yet been tuned, so an initial hyperparameter sweep is the natural next step. · The training objective (loss function) does not align with the competition's evaluation metric, creating a train-eval mismatch. · Previous experiments suggest that certain hyperparameters (e.g., dropout and learning rate) interact and should be tuned jointly.\n    - **Choose a model family or initialization** `T.5.1`\n      - decide: Which replacement model should I test as a standalone candidate? → Change pretrained backbone or capacity | Use domain-adapted pretraining | Change tree learner or boosting variant | Fit a model for a different representation\n      - desiderata · what fits this case?: A compatible alternative pretrained backbone or size is available. · Available pretraining data is substantially closer to the task domain than the current initialization. · The features are tabular or fixed vectors and the current tree implementation has plateaued. · A meaningful input representation is not served well by the current architecture.\n      - desiderata · added from expert visits: The candidate backbone could serve as a useful ensemble component alongside the current model. · Public top solutions or strong notebooks for this competition use the candidate backbone. · A previously tested variant of the candidate backbone scored lower, confirming the current choice or motivating reversion. · The candidate is a known algorithmic variant (e.g., DART, different booster type) within the same library that addresses a specific weakness of the current default. · The change is only an API-level swap within the same library, not a fundamentally different model family. · The candidate variant was already tried and failed to produce a valid submission or caused a runtime error. · The candidate variant was already tested and showed no improvement or degraded performance compared to the current default. · The raw input data modality required by the candidate architecture is accessible and loadable in the inference environment. · A newer or different checkpoint version is available for the candidate backbone with potentially better validation metrics. · Smaller variants of the same model family have already been tested, making the next-size-up variant the natural next candidate. · The current backbone size has been exhaustively tried with multiple checkpoint versions without sustained improvement. · The candidate backbone is known or expected to be architecturally superior to the current one on similar tasks. · The backbone swap code is already implemented but has not yet been scored, so a submission run is needed to get signal. · Disabling other ensemble members allows isolating the candidate model's standalone contribution. · The candidate backbone is being used without pretrained weights, so the capacity change is purely architectural. · The candidate model framework or algorithm has not yet been tried in this pipeline. · The candidate model's prior poor score may be due to a configuration mismatch (e.g., stale thresholds, wrong postprocessing) rather than inherently worse predictions. · A previous submission with the candidate backbone achieved the best single-model leaderboard score. · A larger backbone underperformed a smaller backbone, suggesting model capacity may not be the bottleneck. · The candidate model submission uses fewer ensemble members (folds/seeds) than the best prior submission, making comparison unfair. · The candidate framework offers computational advantages (e.g., GPU acceleration) that could enable faster iteration. · The candidate model's hyperparameter sweep has not yet been submitted, so the current best LB score from the existing model remains the benchmark.\n      - **Change pretrained backbone or capacity** `T.5.1.1`\n      - **Use domain-adapted pretraining** `T.5.1.2`\n      - **Change tree learner or boosting variant** `T.5.1.3`\n      - **Fit a model for a different representation** `T.5.1.4`\n    - **Change the prediction architecture** `T.5.2`\n      - decide: Which architectural component should I alter? → Change head capacity or attention | Change pooling or representation normalization | Add auxiliary supervision | Change feature-level modality fusion | Change training-time dropout\n      - desiderata · what fits this case?: The backbone feeds a minimal, inappropriate shared, or oversized head. · Only one hidden layer or pooling statistic is used despite variable-length or multi-layer information. · An auxiliary target or discretized version of the main target is available. · Multiple informative branches are merged by a lossy or untested rule. · The head overfits or varies markedly across seeds.\n      - desiderata · added from expert visits: A different pretrained checkpoint (with potentially different training settings) is available to swap into the backbone. · The current attention/spatial block variant and its capacity settings have not been fully explored or compared against prior higher-scoring variants. · Multi-sample dropout is an applicable regularization technique for the prediction head on this small noisy regression task. · The normalization layer (e.g., BatchNorm, LayerNorm) in or before the prediction head is missing, mis-wired, or unstable due to small batch sizes. · Reinitializing the last few encoder layers is a viable technique to reduce pretrained bias for small-data fine-tuning. · The pretrained checkpoint's architecture (auxiliary head, fusion rule, pooling) must match the current model definition at load time.\n      - **Change head capacity or attention** `T.5.2.1`\n      - **Change pooling or representation normalization** `T.5.2.2`\n      - **Add auxiliary supervision** `T.5.2.3`\n      - **Change feature-level modality fusion** `T.5.2.4`\n      - **Change training-time dropout** `T.5.2.5`\n    - **Tune a tree learner** `T.5.3`\n      - decide: Which tree-fitting constraint should I adjust? → Tune tree depth and leaves | Tune penalties and subsampling | Coordinate boosting rate and rounds | Change stopping patience or criterion | Reset uncertain tree parameters\n      - desiderata · what fits this case?: Trees appear capacity-limited or increased capacity has begun to overfit. · Training error improves while validation worsens with the current feature set. · Learning rate changed without a corresponding convergence budget. · Stopping occurs before convergence, on the wrong set, or with excessive patience. · Many manually set parameters lack isolated evidence of benefit.\n      - desiderata · added from expert visits: The current parameter sweep has plateaued without clear improvement across recent trials. · Row and column subsampling parameters are at their defaults (no subsampling applied). · The depth/leaves sweep has not yet identified a clear optimum (scores still improving or flat at the boundary). · The most recent parameter change has not yet been submitted or validated on the leaderboard. · The single-parameter sweep has already identified a clear optimum to anchor further interaction sweeps. · The best previous score was achieved with a known configuration, providing a reference point for the current tuning direction. · Public solutions or top notebooks for this competition use substantially different hyperparameter ranges than the current configuration. · Recent regularization parameter perturbations have yielded regressions or negligible/inconsistent score changes. · The previous capacity increase (depth or leaves) caused a score regression, suggesting a revert or reduction. · The feature count was recently changed without an isolated submission to confirm its effect. · The loaded feature subset file may differ from the one that produced the best previous score.\n      - **Tune tree depth and leaves** `T.5.3.1`\n      - **Tune penalties and subsampling** `T.5.3.2`\n      - **Coordinate boosting rate and rounds** `T.5.3.3`\n      - **Change stopping patience or criterion** `T.5.3.4`\n      - **Reset uncertain tree parameters** `T.5.3.5`\n    - **Tune neural optimization or loss** `T.5.4`\n      - decide: Which training change should I test? → Tune learning rate | Change optimizer or learning-rate schedule | Change training duration or stages | Change the training objective | Make component training cross-validated\n      - desiderata · what fits this case?: Training is unstable or converges poorly at the current learning rate. · The training loss stalls at a schedule transition or under the current optimizer. · Training ends while validation improves or continues well beyond its best epoch. · The training loss poorly represents the ranking, distribution, or ordinal evaluation objective. · A component lacks consistent fold training or reproducible held-out predictions.\n      - desiderata · added from expert visits: Changing the loss function alters effective gradient magnitudes, requiring a compensating learning rate adjustment. · The response surface around the current best hyperparameter value has been partially mapped, and small perturbations near it are the natural next step. · A previously tested hyperparameter value produced the best known score and should be reverted to as a baseline before making other changes. · The previous edit changed multiple hyperparameters simultaneously, so individual effects are confounded. · A regularization hyperparameter (e.g., dropout) was changed alongside another modification and may now be mis-calibrated for the current configuration. · The neural network's key hyperparameters (architecture size, learning rate, etc.) have not been tuned from their defaults.\n      - **Tune learning rate** `T.5.4.1`\n      - **Change optimizer or learning-rate schedule** `T.5.4.2`\n      - **Change training duration or stages** `T.5.4.3`\n      - **Change the training objective** `T.5.4.4`\n      - **Make component training cross-validated** `T.5.4.5`\n  - **Change the prediction pool** `T.6`\n    - decide: How should I change which trained predictors contribute? → Choose the source of ensemble diversity | Choose ensemble membership | Select a trained artifact\n    - desiderata · what fits this case?: Existing members mostly share the same architecture, features, targets, or training randomness. · There are untested, weak, or recently changed members in the current pool. · Several compatible saved runs or training-stage artifacts are available.\n    - desiderata · added from expert visits: The fold count has not been varied alongside member selection to understand its interaction with pool composition. · Empirical evidence shows that adding more members to the pool improved the score. · A known preprocessing or architecture variant that already improved the ensemble suggests a further related variant could add diversity. · Validation loss in checkpoint filenames does not reliably predict leaderboard performance, complicating member selection. · A smaller model variant outperformed a larger variant on the leaderboard, suggesting model size is not a reliable proxy for pool contribution. · A candidate subset ensemble has not been submitted, so there is no evidence it outperforms the current full ensemble.\n    - **Choose the source of ensemble diversity** `T.6.1`\n      - decide: What kind of additional predictor should I test? → Add a different model family | Add an alternative input representation | Add an alternative supervision recipe | Average more fold or snapshot predictions | Average independently seeded models | Average checkpoint weights\n      - desiderata · what fits this case?: Current members share a family and their held-out errors are highly correlated. · A relevant modality, feature set, or preprocessing view is not represented. · Alternative valid target transforms or training recipes yield different held-out errors. · Compatible unused fold or snapshot predictions are already available. · Training seeds produce materially different held-out predictions. · Compatible checkpoints from one weight-space trajectory are saved.\n      - **Add a different model family** `T.6.1.1`\n      - **Add an alternative input representation** `T.6.1.2`\n      - **Add an alternative supervision recipe** `T.6.1.3`\n      - **Average more fold or snapshot predictions** `T.6.1.4`\n      - **Average independently seeded models** `T.6.1.5`\n      - **Average checkpoint weights** `T.6.1.6`\n    - **Choose ensemble membership** `T.6.2`\n      - decide: Which membership experiment should I run next? → Measure a candidate in isolation | Test one additional member | Remove a harmful or redundant member | Replace one fixed ensemble slot | Restore complementary members | Retest membership after upstream changes\n      - desiderata · what fits this case?: The candidate has not yet produced verified standalone predictions. · A functioning candidate has plausible complementary errors but no marginal-blend result. · A member is weak, redundant, or associated with a regression. · A new compatible checkpoint can replace a specific weaker slot. · Removing formerly useful members caused a reproducible regression. · Other model components or aggregation rules changed since the last membership test.\n      - **Measure a candidate in isolation** `T.6.2.1`\n      - **Test one additional member** `T.6.2.2`\n      - **Remove a harmful or redundant member** `T.6.2.3`\n      - **Replace one fixed ensemble slot** `T.6.2.4`\n      - **Restore complementary members** `T.6.2.5`\n      - **Retest membership after upstream changes** `T.6.2.6`\n    - **Select a trained artifact** `T.6.3`\n      - decide: Which checkpoint comparison should I perform? → Compare trained runs or folds | Compare training stages or stopping rules | Compare full-data and fold-trained weights\n      - desiderata · what fits this case?: Several runs or fold checkpoints have matching architecture and preprocessing. · Artifacts differ mainly by training stage or stopping criterion. · Both full-data-trained and fold-trained artifacts are available.\n      - **Compare trained runs or folds** `T.6.3.1`\n      - **Compare training stages or stopping rules** `T.6.3.2`\n      - **Compare full-data and fold-trained weights** `T.6.3.3`\n  - **Change prediction combination or output mapping** `T.7`\n    - decide: Which operation on valid predictions should I change? → Choose a combination rule | Choose how to weight predictors | Choose meta-model inputs | Map continuous scores to discrete labels | Correct output semantics or bias | Choose inference-time averaging\n    - desiderata · what fits this case?: Prediction scales or the aggregation domain differ across members. · The same valid prediction pool has only an arbitrary weight allocation. · A downstream learner uses base predictions or embeddings as input features. · The task requires discrete ordered outputs or labels occupy a few repeated levels. · Prediction units, probability calibration, or subgroup residual bias need correction. · The input has valid alternate views that the current inference uses only once.\n    - desiderata · added from expert visits: A code bug or misconfiguration (wrong mode, missing argument, wrong column reference, syntax error, or broken file path) prevents one or more ensemble members from producing correct predictions. · The blending code or saved artifacts are stale or mismatched with the current set of ensemble members. · A previously disabled or excluded model checkpoint is available and was part of a better-scoring configuration. · The pipeline mishandles multi-fold or multi-dimensional prediction arrays, causing shape or aggregation errors. · Non-deterministic execution (e.g., stochastic preprocessing, worker ordering, unseeded randomness) causes prediction outputs to vary across identical runs.\n    - **Choose a combination rule** `T.7.1`\n      - decide: Which rule should I compare against the current aggregation? → Compare rank and raw-score averaging | Compare probability and logit aggregation | Group before averaging | Fit a regularized prediction stacker | Change the meta-learner | Try a nonlinear probability blend\n      - desiderata · what fits this case?: The metric rewards ordering and members have different score scales. · Members expose logits and probabilities for a distribution-based metric. · Model families contribute unequal numbers of fold or seed predictions. · Aligned leakage-free out-of-fold predictions exist for a simple learned blender. · An established stacker has plateaued and its model class or penalty is untested. · Probability saturation may make arithmetic averaging overly dominated by confident members. · Only tiny or noisy calibration data are available relative to meta-model flexibility.\n      - **Compare rank and raw-score averaging** `T.7.1.1`\n      - **Compare probability and logit aggregation** `T.7.1.2`\n      - **Group before averaging** `T.7.1.3`\n      - **Fit a regularized prediction stacker** `T.7.1.4`\n      - **Change the meta-learner** `T.7.1.5`\n      - **Try a nonlinear probability blend** `T.7.1.6`\n    - **Choose how to weight predictors** `T.7.2`\n      - decide: Which weighting strategy should I use as the next comparison? → Tune nonuniform blend weights | Use a uniform-weight baseline | Allow signed blend coefficients | Compare conditional and global weights | Retune after component changes | Normalize component scales\n      - desiderata · what fits this case?: Members differ reliably in quality or complementary error structure. · Equal weighting matches tuned weights within measured score noise. · Prior unconstrained or signed fits suggest a component can cancel correlated error. · Component strengths differ consistently by an observable class or subgroup. · Member quality, count, augmentation, or scaling changed after weights were selected. · Component prediction scales differ substantially or contain heavy outliers.\n      - **Tune nonuniform blend weights** `T.7.2.1`\n      - **Use a uniform-weight baseline** `T.7.2.2`\n      - **Allow signed blend coefficients** `T.7.2.3`\n      - **Compare conditional and global weights** `T.7.2.4`\n      - **Retune after component changes** `T.7.2.5`\n      - **Normalize component scales** `T.7.2.6`\n    - **Choose meta-model inputs** `T.7.3`\n      - decide: Which stacking feature change should I test? → Generate valid out-of-fold meta-features | Add auxiliary stacking features | Select a smaller meta-feature set\n      - desiderata · what fits this case?: Training meta-features include in-sample predictions or inconsistent fold assignments. · Additional aligned auxiliary outputs provide signal not captured by existing base scores. · The meta-feature pool has grown while validation stagnates or regresses.\n      - desiderata · added from expert visits: The meta-learner was trained on a different set of base-model features than what is being fed at inference time. · A previously tested base-model variant (e.g., LightGBM vs XGBoost) achieved higher scores and reverting to it may improve the stack. · A prior attempt to add a candidate meta-feature source (e.g., DeBERTa OOF predictions) failed to produce a valid submission. · Fold-specific or pre-trained model checkpoints are available for generating out-of-fold predictions for a candidate meta-feature source. · External artifact dependencies (pickled models, pre-computed CSVs) are causing load failures or stale/misaligned predictions. · A useful stacking signal column is being inadvertently dropped or excluded from the test-time meta-feature set.\n      - **Generate valid out-of-fold meta-features** `T.7.3.1`\n      - **Add auxiliary stacking features** `T.7.3.2`\n      - **Select a smaller meta-feature set** `T.7.3.3`\n    - **Map continuous scores to discrete labels** `T.7.4`\n      - decide: Which discretization rule should I compare? → Optimize ordinal cutpoints | Use simple clip-and-round | Match empirical target frequencies | Merge or threshold near-equal scores | Compare group-specific cutpoints | Handle degenerate bins and ties\n      - desiderata · what fits this case?: The ordinal metric is sensitive to cutpoints and representative held-out predictions are available. · Optimized thresholds have unstable or worse independent performance than simple rounding. · Known target frequencies are stable enough to support a distribution-matching comparison. · Continuous predictions correspond to a small set of repeated target levels. · Subgroups exhibit different residual-to-label mappings and are observable at prediction time. · Existing binning collapses a column or creates many artificial ties. · The checkpoint or ensemble changed since calibration was fitted.\n      - desiderata · added from expert visits: The evaluation metric is rank-based (e.g., Spearman), so discretization that creates ties or destroys orderings can only degrade performance.\n      - **Optimize ordinal cutpoints** `T.7.4.1`\n      - **Use simple clip-and-round** `T.7.4.2`\n      - **Match empirical target frequencies** `T.7.4.3`\n      - **Merge or threshold near-equal scores** `T.7.4.4`\n      - **Compare group-specific cutpoints** `T.7.4.5`\n      - **Handle degenerate bins and ties** `T.7.4.6`\n    - **Correct output semantics or bias** `T.7.5`\n      - decide: Which output correction should I test or repair? → Restore prediction units and activation | Align risk-score direction | Rescale probabilities or logits | Correct systematic prediction bias | Apply auxiliary or metadata corrections | Ablate an existing output transform\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"mkdir -p output\ncat > output/rewrite.py <<'PY'\nfrom pathlib import Path\nimport json\ns = Path('current_code.py').read_text()\n# Keep the established feature functions, but remove unused neural feature loaders.\na = s.index('embedding_model = SentenceTransformer(')\nb = s.index('# %%\\\\ncolumns = [', a)\ns = s[:a] + '# Topic/similarity features without a reusable fitted transform are excluded.\\\\n\\\\n' + s[b:]\ns = s.replace(\\\"if len(paragraphs) > 1 & len(paragraphs) <= 2:\\\", \\\"if len(paragraphs) == 2:\\\")\ns = s.replace(\\\".apply(lambda x: extract_essay_parts(x)[\\\", \\\".map_elements(lambda x: extract_essay_parts(x)[\\\")\ns = s.replace(\\\"deberta_models = glob(MODEL_PATH)\\\", \\\"deberta_models = sorted(glob(MODEL_PATH))\\\\nassert deberta_models, 'No DeBERTa checkpoints found'\\\")\n# Drop unused imports whose optional dependencies are unnecessary here.\nfor line in ['import gensim\\\\n', 'from gensim.models import CoherenceModel\\\\n', 'import gensim.corpora as corpora\\\\n', 'from gensim.corpora import Dictionary\\\\n', 'from imblearn.ensemble import BalancedBaggingClassifier\\\\n', 'from bertopic import BERTopic\\\\n', 'from sentence_transformers import SentenceTransformer\\\\n']:\n    s = s.replace(line, '')\ns = s.replace('import warnings\\\\n', 'from IPython.display import display\\\\nimport warnings\\\\n')\nstart = s.index('# %%\\\\nimport pickle\\\\nwith open(\\\\'/kaggle/input/essay-scoring-features/train_df_30jun.pkl\\\\'')\ns = s[:start] + '''# %%\n# Preserve the cached training features, but key every attachment by essay_id.\nwith open('/kaggle/input/essay-scoring-features/train_df_30jun.pkl', 'rb') as fi:\n    train_feats = pd.DataFrame(pickle.load(fi))\nraw_train = pd.read_csv(PATH + 'train.csv')\nraw_test = pd.read_csv(TEST_DATA_PATH)\nassert train_feats['essay_id'].is_unique\nassert set(train_feats['essay_id']) == set(raw_train['essay_id'])\ntrain_feats = train_feats.set_index('essay_id').loc[raw_train['essay_id']].reset_index()\ntrain_feats['score'] = raw_train['score'].to_numpy()\n\n# Build features for the actual rerun test set. A saved public-test dataframe\n# cannot represent the private test essays.\ntest_feats = raw_test[['essay_id']].copy()\nfor part in ['paragraph', 'introduction', 'body', 'conclusion']:\n    part_features = Essay_Parts_Eng(Essay_Parts_Preprocess(test, part, 'test'), part)\n    test_feats = test_feats.merge(part_features, on='essay_id', how='left', validate='one_to_one')\n    del part_features\n    gc.collect()\ntest_feats = test_feats.merge(Sentence_Eng(Sentence_Preprocess(test)),\n                              on='essay_id', how='left', validate='one_to_one')\ntest_feats = test_feats.merge(Word_Eng(Word_Preprocess(test)),\n                              on='essay_id', how='left', validate='one_to_one')\n\n# Recompute the inexpensive essay-level linguistic block on both populations\n# with identical preprocessing, avoiding assumptions about cache normalization.\nfor raw, feats in [(raw_train, train_feats), (raw_test, test_feats)]:\n    linguistic_input = raw[['full_text']].copy()\n    linguistic_input['full_text'] = linguistic_input['full_text'].map(dataPreprocessing)\n    linguistic = extract_linguistic_features_in_batches(linguistic_input)\n    for col in linguistic:\n        feats[col] = linguistic[col].to_numpy()\n    del linguistic_input, linguistic\n    gc.collect()\n\n# %%\n# The original identity tokenizer produced character n-grams. Preserve its\n# vocabulary/feature semantics so the saved feature ranking remains applicable.\nvectorizer = TfidfVectorizer(\n    tokenizer=lambda x: x, preprocessor=lambda x: x, token_pattern=None,\n    strip_accents='unicode', analyzer='word', ngram_range=(3, 6),\n    min_df=0.05, max_df=0.95, sublinear_tf=True, dtype=np.float32)\nvectorizer_cnt = CountVectorizer(\n    tokenizer=lambda x: x, preprocessor=lambda x: x, token_pattern=None,\n    strip_accents='unicode', analyzer='word', ngram_range=(2, 3),\n    min_df=0.10, max_df=0.85, dtype=np.int32)\nfor vec, prefix in [(vectorizer, 'tfid_'), (vectorizer_cnt, 'tfid_cnt_')]:\n    train_matrix = vec.fit_transform(raw_train['full_text'])\n    test_matrix = vec.transform(raw_test['full_text'])\n    cols = [f'{prefix}{i}' for i in range(train_matrix.shape[1])]\n    # Frames have explicitly been put in raw CSV order before positional joins.\n    train_feats = train_feats.drop(columns=cols, errors='ignore')\n    test_feats = test_feats.drop(columns=cols, errors='ignore')\n    train_feats = pd.concat([train_feats, pd.DataFrame(train_matrix.toarray(), columns=cols)], axis=1)\n    test_feats = pd.concat([test_feats, pd.DataFrame(test_matrix.toarray(), columns=cols)], axis=1)\n    del train_matrix, test_matrix\n    gc.collect()\n\n# %%\nimport joblib\n\ndef probability_matrix(values, expected_rows):\n    values = np.asarray(values, dtype=np.float32)\n    assert values.shape == (expected_rows, 6), values.shape\n    assert np.isfinite(values).all()\n    if values.min() < 0 or not np.allclose(values.sum(axis=1), 1, atol=1e-3):\n        values = softmax(values, axis=1)\n    return values\n\n# The supplied ndarray OOF artifact has no IDs: retain its existing train.csv\n# row-order contract, then attach to the explicitly aligned feature dataframe.\ndeberta_oof = probability_matrix(\n    joblib.load('/kaggle/input/aes2-400-20240419134941/oof.pkl'), len(raw_train))\npredicted_score = probability_matrix(predicted_score, len(raw_test))\nfor i in range(6):\n    train_feats[f'deberta_oof_{i}'] = deberta_oof[:, i]\n    test_feats[f'deberta_oof_{i}'] = predicted_score[:, i]\n\nfb_oof = pd.read_csv('/kaggle/usr/lib/fb3_deberta_family_inference_9_28_updated_320784/submission.csv')\nfb_test = get_fb3_predicted(raw_test.copy())\nfb_cols = [c for c in fb_oof.columns if c \"'!= '\"'text_id']\nfor values in [fb_oof, fb_test]:\n    assert values['text_id'].is_unique\ntrain_feats = train_feats.drop(columns=fb_cols, errors='ignore').merge(\n    fb_oof.rename(columns={'text_id': 'essay_id'}), on='essay_id', how='left', validate='one_to_one')\ntest_feats = test_feats.drop(columns=fb_cols, errors='ignore').merge(\n    fb_test.rename(columns={'text_id': 'essay_id'}), on='essay_id', how='left', validate='one_to_one')\nassert train_feats['essay_id'].tolist() == raw_train['essay_id'].tolist()\nassert test_feats['essay_id'].tolist() == raw_test['essay_id'].tolist()\n\n# %%\nwith open('/kaggle/input/essay-scoring-features/usefe_list_30jun.pkl', 'rb') as fi:\n    ranked_features = list(pickle.load(fi))\n# Never train on topic/similarity/cache-only features that cannot be computed\n# for private-test rows. Keep the established 4500-feature budget.\navailable = [c for c in ranked_features\n             if c in train_feats and c in test_feats\n             and c not in ('essay_id', 'score')\n             and pd.api.types.is_numeric_dtype(train_feats[c])\n             and pd.api.types.is_numeric_dtype(test_feats[c])]\nfeature_select = list(dict.fromkeys(available[:4500] +\n    [f'deberta_oof_{i}' for i in range(6)] + fb_cols))\nassert feature_select\nprint('Selected reproducible features:', len(feature_select))\nX = train_feats[feature_select].replace([np.inf, -np.inf], np.nan).astype(np.float32).to_numpy()\nX_test = test_feats[feature_select].replace([np.inf, -np.inf], np.nan).astype(np.float32).to_numpy()\ny_split = raw_train['score'].to_numpy(dtype=np.int32)\n# Preserve the natural score distribution: no downsampling, synthetic rows,\n# pre-split imputation, or inverse-class weights. LightGBM handles NaNs natively.\na = float(y_split.mean())\nb = float(y_split.var())\ny = y_split.astype(np.float64) - a\noof = np.full(len(y), np.nan, dtype=np.float64)\n\n# %%\ndef quadratic_weighted_kappa(y_true, y_pred):\n    labels = np.rint(y_true + a).astype(int)\n    preds = np.rint(np.clip(y_pred + a, 1, 6)).astype(int)\n    return 'QWK', cohen_kappa_score(labels, preds, weights='quadratic'), True\n\ndef qwk_obj(y_true, y_pred):\n    labels = y_true + a\n    preds = (y_pred + a).clip(1, 6)\n    f = 0.5 * np.sum((preds - labels) ** 2)\n    g = max(0.5 * np.sum((preds - a) ** 2 + b), 1e-12)\n    grad = ((preds - labels) / g - f * (preds - a) / g ** 2) * len(labels)\n    return grad, np.ones(len(labels))\n\nn_splits = 15\nskf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=0)\nmodels = []\ntest_predictions = np.zeros(len(raw_test), dtype=np.float64)\nfor fold, (train_index, valid_index) in enumerate(skf.split(X, y_split)):\n    model = lgb.LGBMRegressor(\n        objective=qwk_obj, metric='None', learning_rate=0.05,\n        max_depth=5, num_leaves=10, colsample_bytree=0.3,\n        reg_alpha=0.7, reg_lambda=0.1, n_estimators=700,\n        random_state=42, extra_trees=True, verbosity=-1,\n        device='gpu' if torch.cuda.is_available() else 'cpu')\n    model.fit(X[train_index], y[train_index],\n              eval_set=[(X[valid_index], y[valid_index])],\n              eval_metric=quadratic_weighted_kappa,\n              callbacks=[log_evaluation(100), early_stopping(75, first_metric_only=True)])\n    oof[valid_index] = model.predict(X[valid_index]) + a\n    test_predictions += (model.predict(X_test) + a) / n_splits\n    models.append(model)\n    print('Fold', fold + 1, quadratic_weighted_kappa(y[valid_index], oof[valid_index] - a))\nassert np.isfinite(oof).all()\nassert np.isfinite(test_predictions).all()\n\n# %%\n# Tune modest, ordered cutpoint shifts; compare on separate calibration folds.\n# This is a postprocessing diagnostic, not a fully nested estimate of the stack.\nBASE_CUTS = np.arange(1.5, 6.0, 1.0)\n\ndef discretize(pred, cuts):\n    return np.searchsorted(cuts, pred, side='right') + 1\n\ndef fit_cutpoints(pred, labels):\n    cuts = BASE_CUTS.copy()\n    best = cohen_kappa_score(labels, discretize(pred, cuts), weights='quadratic')\n    for step in (0.05, 0.02, 0.01):\n        for _ in range(3):\n            changed = False\n            for j in range(5):\n                chosen = cuts[j]\n                for candidate in np.arange(BASE_CUTS[j] - 0.25, BASE_CUTS[j] + 0.2501, step):\n                    if j and candidate <= cuts[j - 1] + 0.2:\n                        continue\n                    if j < 4 and candidate >= cuts[j + 1] - 0.2:\n                        continue\n                    trial = cuts.copy()\n                    trial[j] = candidate\n                    score = cohen_kappa_score(labels, discretize(pred, trial), weights='quadratic')\n                    if score > best + 1e-7:\n                        best, chosen = score, candidate\n                changed |= abs(cuts[j] - chosen) > 1e-8\n                cuts[j] = chosen\n            if not changed:\n                break\n    return cuts\n\ncalibrated_oof = np.zeros(len(y_split), dtype=np.int32)\ncalibration = StratifiedKFold(n_splits=5, shuffle=True, random_state=2024)\ncalibration_cuts = []\nfor fit_idx, check_idx in calibration.split(oof, y_split):\n    cuts = fit_cutpoints(oof[fit_idx], y_split[fit_idx])\n    calibration_cuts.append(cuts)\n    calibrated_oof[check_idx] = discretize(oof[check_idx], cuts)\nbase_qwk = cohen_kappa_score(y_split, discretize(oof, BASE_CUTS), weights='quadratic')\ncalibrated_qwk = cohen_kappa_score(y_split, calibrated_oof, weights='quadratic')\n# A small positive margin discourages retaining noise-driven corrections.\nfinal_cuts = (np.mean(calibration_cuts, axis=0)\n              if calibrated_qwk > base_qwk + 0.0005 else BASE_CUTS)\nprint('Raw OOF QWK:', base_qwk, 'cross-fitted cutpoints QWK:', calibrated_qwk)\nprint('Submission cutpoints:', final_cuts)\npd.DataFrame({'essay_id': raw_train['essay_id'], 'score': y_split,\n              'prediction': oof}).to_csv('/kaggle/working/oof_predictions.csv', index=False)\n\n# %%\nscore_by_id = pd.Series(discretize(test_predictions, final_cuts),\n                        index=raw_test['essay_id'])\nsubmission = pd.read_csv(PATH + 'sample_submission.csv')\nsubmission['score'] = submission['essay_id'].map(score_by_id)\nassert submission['score'].notna().all()\nsubmission['score'] = submission['score'].astype(int)\nassert submission['score'].between(1, 6).all()\nsubmission[['essay_id', 'score']].to_csv('submission.csv', index=False)\ndisplay(submission.head())\n'''\nPath('output/revised_code.py').write_text(s)\nobs = []\ndef add(q, r, e): obs.append(dict(observation=q, result='yes' if r else 'no', evidence=e))\nadd('Does the supplied memory identify restoration after a regression as a candidate decision?', True, 'memory/taxonomy.md, T.1.3, lists restoring the proven configuration following regression.')\nadd('Does the competition reward higher quadratic weighted kappa?', True, 'task.md Evaluation and summary specify QWK, higher is better.')\nadd('Does the required submission contain integer scores from 1 to 6?', True, 'task.md Data describes the 1-6 scale; Submission File specifies essay_id,score.')\nadd('Has the current score fallen below an earlier scored version?', True, 'history.md: v26 scored 0.81897; v32 scored 0.80731.')\nadd('Did the score fall after the introduction of resampling?', True, 'history.md: v29 0.81830; v30 introduced imputation/SMOTE; v31 0.81098. This is an association, not an isolated causal comparison.')\nadd('Did v32 restore the earlier feature extraction pipeline?', False, 'history.md v31 -> v32 says heavy feature extraction blocks were disabled; score fell by 0.00367.')\nadd('Does the current model consume DeBERTa probability features?', True, 'current_code.py lines 94-116 average softmax predictions; lines 853-863 attach OOF probabilities.')\nadd('Is SMOTE applied before the validation folds are assigned?', True, 'current_code.py lines 934-950 resample topic groups; line 1094 constructs StratifiedKFold afterward.')\nadd('Does the current code impute training features globally before splitting?', True, 'current_code.py lines 937-938 fit SimpleImputer on each full topic subset before cross-validation.')\nadd('Does the current OOF buffer have a floating-point dtype?', False, 'current_code.py line 960 initializes oof from score.astype(int), truncating continuous assignments at line 1136.')\nadd('Does the current submission optimize ordinal cutpoints?', False, 'current_code.py line 1244 applies fixed clip-and-round.')\nadd('Does the memory favor checking data flow before further modeling changes?', True, 'memory/attention/t-2-2-locate-a-data-flow-defect.md prioritizes tracing input/prediction signal and checking identifier alignment.')\nadd('Does the memory support cutpoint optimization using held-out predictions?', True, 'memory/attention/t-7-4-map-continuous-scores-to-discrete-labels.md lists optimizing ordinal cutpoints when the ordinal metric is sensitive to them.')\nadd('Does the test feature pipeline load a static test dataframe?', True, 'current_code.py lines 1166-1169 load /kaggle/input/essay-scoring-features/df_test.pkl, later merged into live test features. Private-test coverage cannot be verified without data.')\nadd('Are all essay-part test feature blocks active?', False, 'current_code.py lines 1172-1191 disable introduction/body/conclusion feature construction; only paragraph construction remains active.')\nadd('Does the original vectorizer tokenize text into words?', False, 'current_code.py lines 812-819 use tokenizer=lambda x:x on strings, so word-analyzer n-grams are effectively character sequences. The revision preserves this feature-index contract.')\nadd('Are sparse features attached using their source CSV identifiers?', False, 'current_code.py lines 828, 850, 1210, 1220 assign feature-frame essay_id from train_feats/test_feats instead of the raw text rows used to produce the matrix.')\nadd('Does the test aggregation sort essay identifiers?', True, 'current_code.py Essay_Parts_Eng, Sentence_Eng, and Word_Eng call sort(\\\"essay_id\\\"). Positional prediction assignment therefore relies on matching input order.')\nadd('Does the two-paragraph condition use a logical conjunction?', False, 'current_code.py line 193 uses a bitwise & within chained comparisons; the revision uses len(paragraphs) == 2.')\nadd('Does the LightGBM configuration also request balanced class weights?', True, 'current_code.py line 1123 sets class_weight=\\\"balanced\\\" after synthetic balancing.')\nadd('Are custom-objective target moments fixed constants?', True, 'current_code.py lines 902-903 set a=2.998 and b=1.092; the revision derives moments from the actual unresampled labels.')\nadd('Can the row identity of the external OOF ndarray be independently verified here?', False, 'current_code.py loads oof.pkl as a six-column array without IDs; competition artifacts are unavailable. The existing train.csv ordering assumption is retained explicitly.')\nadd('Does the task note a training-to-test source shift?', True, 'task.md summary says the test resembles non-Persuade data; no source labels are available locally, so calibration shifts are bounded and cross-checked.')\nreport = dict(observations=obs, action_summary='Remove pre-CV topic downsampling, SMOTE, mean imputation, and inverse-class weighting to restore the natural training distribution after the documented regression. Repair floating-point OOF storage and identifier alignment; generate live test features instead of merging a static public-test cache, retaining only reproducible ranked features and transformer stacking outputs. Keep the established LightGBM ensemble, derive QWK objective moments from the real labels, and adopt bounded ordinal cutpoints only when cross-fitted calibration improves QWK. No training or inference was run; leaderboard improvement remains unmeasured.')\nPath('output/report.json').write_text(json.dumps(report, indent=2))\nPY\npython output/rewrite.py\npython -m py_compile output/revised_code.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
