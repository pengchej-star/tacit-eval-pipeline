= cohen_kappa_score(y_true, y_pred, weights=\"quadratic\")\n    return 'QWK', qwk, True\ndef qwk_obj(y_true, y_pred):\n    labels = y_true + a\n    preds = y_pred + a\n    preds = preds.clip(1, 6)\n    f = 1/2*np.sum((preds-labels)**2)\n    g = 1/2*np.sum((preds-a)**2+b)\n    df = preds - labels\n    dg = preds - a\n    grad = (df/g - f*dg/g**2)*len(labels)\n    hess = np.ones(len(labels))\n    return grad, hess\na = 2.998\nb = 1.092\n\n# %%\nimport pickle\nwith open('/kaggle/input/essay-scoring-features/usefe_list_30jun.pkl', mode='br') as fi:\n  feature_names = pickle.load(fi)\nfeature_select = feature_names\n\nfeature_select = feature_select[0:4500]\n\n# %%\ntopic_columns= [col for col in train_feats.columns if col.startswith('topic_')]\ntrain_feats['topic'] = train_feats[topic_columns].idxmax(axis=1).apply(lambda x: int(x.split('_')[1]))\n\n\n# %%\ndef downsample(df, max_count=1500):\n    downsampled_df = df.groupby(['topic', 'score'], group_keys=False).apply(lambda x: x.sample(min(len(x), max_count), random_state=42))\n    return downsampled_df\n\ndownsampled_df = downsample(train_feats)\n\n\n# %%\nfrom sklearn.impute import SimpleImputer\nfrom imblearn.over_sampling import SMOTE\n\nbalanced_dataframes = []\n\nfor topic in downsampled_df['topic'].unique():\n    topic_df = downsampled_df[downsampled_df['topic'] == topic]\n    X = topic_df[feature_select]\n    y = topic_df['score']\n    \n    imputer = SimpleImputer(strategy='mean')\n    X_imputed = imputer.fit_transform(X)\n    \n    # Apply SMOTE\n    smote = SMOTE(random_state=42)\n    X_resampled, y_resampled = smote.fit_resample(X_imputed, y)\n    \n    # Combine resampled features and target\n    resampled_df = pd.DataFrame(X_resampled, columns= feature_select)\n    resampled_df['score'] = y_resampled\n    \n    # Append to the list of balanced dataframes\n    balanced_dataframes.append(resampled_df)\n\n# Concatenate all balanced dataframes\nbalanced_df = pd.concat(balanced_dataframes, ignore_index=True)\n\n\n# %%\nX = balanced_df[feature_select].astype(np.float32).values  # feature_names\ny_split = balanced_df['score'].astype(int).values\ny = balanced_df['score'].astype(np.float32).values-a\noof = balanced_df['score'].astype(int).values\n\n\n# %%\n\"\"\"from sklearn.impute import SimpleImputer\nfrom imblearn.over_sampling import SMOTE\n\n\nX = train_feats[feature_select]  # Features\ny = train_feats['score']  # Target variable\n\n# Impute missing values in the features\nimputer = SimpleImputer(strategy='mean')\nX_imputed = imputer.fit_transform(X)\n\nsmote = SMOTE(random_state=42)\nX_resampled, y_resampled = smote.fit_resample(X_imputed, y)\ny_resampled = np.array(y_resampled).reshape(-1)\n\"\"\"\n\n# %%\n\"\"\"X = X_resampled \ny_split = y_resampled\ny = np.array(y_resampled, dtype= np.float32)-a\noof = y_resampled\n\"\"\"\n\n# %%\n\"\"\"X = train_feats[feature_select].astype(np.float32).values  # feature_names\ny_split = train_feats['score'].astype(int).values\ny = train_feats['score'].astype(np.float32).values-a\noof = train_feats['score'].astype(int).values\n\"\"\"\n\n# %%\ndef feature_select_wrapper():\n\n","exit_code":0,"status":"completed"}}
