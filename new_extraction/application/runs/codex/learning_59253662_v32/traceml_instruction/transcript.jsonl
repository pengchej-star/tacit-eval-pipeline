[np.argmax(scores)]\n\nmeta_oof = np.empty(len(y), dtype=np.float64)\nfold_weights = []\nfor fold in range(n_splits):\n    valid = fold_ids == fold\n    weights = select_blend(oof_matrix[~valid], y_split[~valid])\n    meta_oof[valid] = oof_matrix[valid] @ weights\n    fold_weights.append(weights)\nbase_score = qwk_score(y_split, oof_matrix[:, 0])\nmeta_score = qwk_score(y_split, meta_oof)\nblend_weights = (np.mean(fold_weights, axis=0) if meta_score > base_score + 0.0005\n                 else np.array([1., 0., 0.]))\nprint('OOF base QWK:', base_score, 'cross-fitted blend QWK:', meta_score,\n      'chosen weights:', blend_weights)\nimport json\nwith open('/kaggle/working/aes_blend.json', 'w') as file:\n    json.dump({'weights': blend_weights.tolist(), 'feature_names': feature_select,\n               'base_qwk': base_score, 'meta_qwk': meta_score}, file)\ngc.collect()\ntorch.cuda.empty_cache()\n\n''' + s[end:]\ns=s.replace(\\\"for i in range(6):\\\\n    test_feats[f'deberta_oof_{i}'] = predicted_score[:, i]\\\", '''deberta_test = probability_features(predicted_score)\ndeberta_test['essay_id'] = pd.read_csv(TEST_DATA_PATH)['essay_id'].to_numpy()\ntest_feats = test_feats.merge(deberta_test, on='essay_id', how='left',\n                              sort=False, validate='one_to_one')''')\ns=s.replace('pd.merge(test_feats,fb3_predicted, left_on=\\\"essay_id\\\", right_on=\\\"text_id\\\")','pd.merge(test_feats,fb3_predicted, left_on=\\\"essay_id\\\", right_on=\\\"text_id\\\", how=\\\"left\\\", sort=False, validate=\\\"one_to_one\\\")')\nstart=s.index('# %%\\\\nprobabilities = []\\\\nfor model in models:')\ns=s[:start]+'''# %%\nX_test = test_feats.reindex(columns=feature_select).replace(\n    [np.inf, -np.inf], np.nan).astype(np.float32)\ntest_matrix = np.column_stack([\n    np.mean([model.predict(X_test) + a for model in models_by_family[family]], axis=0)\n    for family in ['qwk', 'l2']\n] + [test_feats['deberta_mean'].to_numpy()])\ncontinuous_predictions = test_matrix @ blend_weights\nnp.save('/kaggle/working/aes_test_predictions.npy', test_matrix)\nprediction_frame = pd.DataFrame({\n    'essay_id': test_feats['essay_id'],\n    'score': np.rint(continuous_predictions).clip(1, 6).astype(int),\n})\n\n# %%\nsubmission = pd.read_csv(PATH + 'sample_submission.csv')[['essay_id']]\nsubmission = submission.merge(prediction_frame, on='essay_id', how='left',\n                              sort=False, validate='one_to_one')\nassert submission['score'].notna().all(), 'Missing predictions for test essay IDs'\nsubmission['score'] = submission['score'].astype(int)\nassert submission['score'].between(1, 6).all()\nsubmission.to_csv('submission.csv', index=False)\nprint(submission.head())\n'''\nPath('output/revised_code.py').write_text(s)\nobs=[\n('Does the competition use quadratic weighted kappa?', 'yes', 'task.md Evaluation specifies QWK, with higher scores better.'),\n('Are the target scores integers from 1 through 6?', 'yes', 'task.md Data describes the six-point holistic score and essay_id,score submission.'),\n('Is v32 below the best scored version shown in history?', 'yes', 'history.md records v26 at 0.81897 and v32 at 0.80731.'),\n('Did the first scored version after the SMOTE change improve over v29?', 'no', 'history.md: v29 0.81830; SMOTE added in v30; v31 scored 0.81098.'),\n('Does v32 perform resampling before constructing CV folds?', 'yes', 'current_code.py builds balanced_df with topic downsampling and SMOTE before StratifiedKFold.'),\n('Does v32 use K-fold validation?', 'yes', 'current_code.py uses 15-fold StratifiedKFold for LightGBM.'),\n('Does v32 initialize its OOF buffer with integer labels?', 'yes', \\\"current_code.py assigns oof = balanced_df['score'].astype(int).values before writing continuous predictions.\\\"),\n('Does v32 apply balanced class weights to its regressor?', 'yes', \\\"current_code.py LGBMRegressor has class_weight='balanced'; the competition metric has no class reweighting.\\\"),\n('Does the QWK surrogate use