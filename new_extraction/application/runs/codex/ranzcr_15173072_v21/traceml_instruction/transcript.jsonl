udyInstanceUID=test['StudyInstanceUID'].to_numpy(dtype=str),\n        target_cols=np.asarray(target_cols, dtype=str),\n        predictions=scale_predictions,\n    )\n    predictions += weight * scale_predictions\n    del test_loader, test_dataset, scale_predictions\n\n# %%\n# AUC depends on ranking: multiplying probabilities by 100 cannot improve it.\n# Write actual probabilities in the exact sample-submission row/column order.\nassert np.isfinite(predictions).all()\nassert ((predictions >= 0.0) & (predictions <= 1.0)).all()\ntest[target_cols] = predictions\ntest[['StudyInstanceUID'] + target_cols].to_csv('submission.csv', index=False)\nprint(test.head())\nPY\ncat > output/report.json <<'JSON'\n{\n  \\\"observations\\\": [\n    {\\\"observation\\\": \\\"Is the evaluation metric an equally weighted mean of 11 label AUCs?\\\", \\\"result\\\": \\\"yes\\\", \\\"evidence\\\": \\\"task.md, Evaluation: AUC is calculated for each of the 11 labels, then averaged; higher is better.\\\"},\n    {\\\"observation\\\": \\\"Does the competition require submission probabilities?\\\", \\\"result\\\": \\\"yes\\\", \\\"evidence\\\": \\\"task.md, Submission File: predict a probability for all target variables; the required output filename is submission.csv.\\\"},\n    {\\\"observation\\\": \\\"Does the history contain a score higher than v21?\\\", \\\"result\\\": \\\"yes\\\", \\\"evidence\\\": \\\"history.md: v13 and v14 scored 0.96062, compared with v21 at 0.95243.\\\"},\n    {\\\"observation\\\": \\\"Did the documented switch from 640 to 512 improve the score?\\\", \\\"result\\\": \\\"yes\\\", \\\"evidence\\\": \\\"history.md, v12 to v13: IMAGE_SIZE 640 to 512, with batch size 12 to 64, accompanied a score increase from 0.95987 to 0.96062. This is historical evidence, not an isolated controlled experiment.\\\"},\n    {\\\"observation\\\": \\\"Did increasing batch size from 64 to 128 change the recorded score?\\\", \\\"result\\\": \\\"no\\\", \\\"evidence\\\": \\\"history.md, v13 to v1